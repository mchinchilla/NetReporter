<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetReporter.Core\NetReporter.Core.csproj" />
    <ProjectReference Include="..\..\src\NetReporter.Pdf\NetReporter.Pdf.csproj" />
    <ProjectReference Include="..\..\src\NetReporter.Templates\NetReporter.Templates.csproj" />
    <ProjectReference Include="..\..\src\NetReporter.Svg\NetReporter.Svg.csproj" />
    <ProjectReference Include="..\..\src\NetReporter.Barcodes\NetReporter.Barcodes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.2.4" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Update="report.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="invoice-laser.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="invoice-paperoll.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="invoice-data.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="wrap-demo.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="wrap-data.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="grouped-invoice.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="grouped-invoice-data.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="invoice-with-qr.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
