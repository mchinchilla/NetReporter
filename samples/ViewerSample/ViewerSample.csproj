<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetReporter.Viewer\NetReporter.Viewer.csproj" />
    <ProjectReference Include="..\..\src\NetReporter.Templates\NetReporter.Templates.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Reuse the TemplateSample templates and data -->
  <ItemGroup>
    <None Include="..\TemplateSample\*.yaml;..\TemplateSample\*.json" LinkBase="Reports" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
