<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Builds on macOS/Linux (CI); runs on Windows only -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetReporter.Viewer.WinForms\NetReporter.Viewer.WinForms.csproj" />
    <ProjectReference Include="..\..\src\NetReporter.Templates\NetReporter.Templates.csproj" />
  </ItemGroup>

  <!-- The TemplateSample templates, data and logo, copied next to the executable -->
  <ItemGroup>
    <None Include="..\TemplateSample\*.yaml;..\TemplateSample\*.json;..\TemplateSample\logo.png"
          Link="Templates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
