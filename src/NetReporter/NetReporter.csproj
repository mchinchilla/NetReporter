<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Meta-package: "dotnet add package NetReporter" pulls in the whole engine
    (Core + Templates + every renderer + Barcodes). It ships no assembly of its own.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Description>Reporting engine for .NET with an intermediate representation: one template (C# API or YAML) produces PDF, HTML, SVG and XLSX. This meta-package references NetReporter.Core, NetReporter.Templates, NetReporter.Pdf, NetReporter.Svg, NetReporter.Html, NetReporter.Xlsx and NetReporter.Barcodes.</Description>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Empty lib/<tfm>/_._ placeholder: no assembly, but NuGet clients and nuget.org see which framework
    the package targets (nuget.org shows the ".NET 10.0" badge only for packages with lib/ assets).
  -->
  <ItemGroup>
    <None Include="_._" Pack="true" PackagePath="lib/$(TargetFramework)/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetReporter.Core\NetReporter.Core.csproj" />
    <ProjectReference Include="..\NetReporter.Templates\NetReporter.Templates.csproj" />
    <ProjectReference Include="..\NetReporter.Pdf\NetReporter.Pdf.csproj" />
    <ProjectReference Include="..\NetReporter.Svg\NetReporter.Svg.csproj" />
    <ProjectReference Include="..\NetReporter.Html\NetReporter.Html.csproj" />
    <ProjectReference Include="..\NetReporter.Xlsx\NetReporter.Xlsx.csproj" />
    <ProjectReference Include="..\NetReporter.Barcodes\NetReporter.Barcodes.csproj" />
  </ItemGroup>

</Project>
