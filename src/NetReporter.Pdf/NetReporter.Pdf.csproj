<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NetReporter.Core\NetReporter.Core.csproj" />
    <ProjectReference Include="..\NetReporter.Svg\NetReporter.Svg.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetReporter.Pdf.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>PDF renderer for NetReporter: vector output with selectable text and subset-embedded fonts, written with SkiaSharp's PDF backend. No third-party license required.</Description>
  </PropertyGroup>

</Project>
