<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Report viewer for ASP.NET Core apps: app.MapNetReporterViewer("/reports", ...) serves a paginated, zoomable viewer (the &lt;netreporter-viewer&gt; web component, no CDN dependencies) with thumbnails, print and PDF/HTML/XLSX download. Pages are rendered as SVG on demand.</Description>
    <PackageTags>$(PackageTags);viewer;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetReporter.Core\NetReporter.Core.csproj" />
    <ProjectReference Include="..\NetReporter.Svg\NetReporter.Svg.csproj" />
    <ProjectReference Include="..\NetReporter.Pdf\NetReporter.Pdf.csproj" />
    <ProjectReference Include="..\NetReporter.Html\NetReporter.Html.csproj" />
    <ProjectReference Include="..\NetReporter.Xlsx\NetReporter.Xlsx.csproj" />
    <ProjectReference Include="..\NetReporter.Barcodes\NetReporter.Barcodes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\viewer.js" LogicalName="NetReporter.Viewer.viewer.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetReporter.Viewer.Tests" />
  </ItemGroup>

</Project>
