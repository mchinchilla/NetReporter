<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NetReporter.Core\NetReporter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <!-- SkiaSharp only ships macOS/Windows natives for net10.0; this adds linux-x64/arm64/musl so the package works on Linux hosts and CI -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>SVG renderer for NetReporter: one SVG document per page via SkiaSharp. Also used by the PDF renderer and the Designer preview.</Description>
  </PropertyGroup>

</Project>
