@model NetReporter.Designer.Models.DesignerViewModel
@{
    ViewData["Title"] = "Designer";
    const string Cm = "https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/";
}

<link rel="stylesheet" href="@(Cm)codemirror.min.css">
<link rel="stylesheet" href="@(Cm)addon/fold/foldgutter.min.css">
<link rel="stylesheet" href="@(Cm)addon/dialog/dialog.min.css">
<script src="@(Cm)codemirror.min.js"></script>
<script src="@(Cm)mode/yaml/yaml.min.js"></script>
<script src="@(Cm)mode/javascript/javascript.min.js"></script>
<script src="@(Cm)addon/selection/active-line.min.js"></script>
<script src="@(Cm)addon/edit/matchbrackets.min.js"></script>
<script src="@(Cm)addon/fold/foldcode.min.js"></script>
<script src="@(Cm)addon/fold/foldgutter.min.js"></script>
<script src="@(Cm)addon/fold/indent-fold.min.js"></script>
<script src="@(Cm)addon/fold/brace-fold.min.js"></script>
<script src="@(Cm)addon/dialog/dialog.min.js"></script>
<script src="@(Cm)addon/search/searchcursor.min.js"></script>
<script src="@(Cm)addon/search/search.min.js"></script>
<script src="@(Cm)addon/search/jump-to-line.min.js"></script>
<style>
    .cm-host { position: relative; flex: 1 1 0; min-height: 0; }
    .cm-host > .CodeMirror {
        position: absolute; inset: 0; height: auto;
        font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: 12px; line-height: 1.5;
    }
    .cm-host .CodeMirror-activeline-background { background: #f1f5f9; }
    .cm-host .CodeMirror-gutters { background: #f8fafc; border-right: 1px solid #e2e8f0; }
    .cm-host .CodeMirror-linenumber { color: #94a3b8; }
    .cm-host .cm-linked-line { background: rgba(245, 158, 11, 0.12); }
    .cm-host .cm-linked-gutter { box-shadow: inset 3px 0 0 rgb(245, 158, 11); }
    .cm-host .cm-error-line { background: rgba(239, 68, 68, 0.12); }
    .cm-host .cm-error-marker { color: #dc2626; font-size: 11px; padding-left: 3px; cursor: default; }
    .cm-host .error-gutter { width: 14px; }
    /* El elemento bajo el cursor del YAML se resalta en el preview */
    .element-overlay.yaml-cursor { outline: 2px dotted rgb(14, 165, 233); outline-offset: 1px; }
    /* Cuadrícula: alineada al origen del contenido (márgenes), igual que bounds.x del YAML */
    #preview.show-grid .svg-page::after {
        content: ''; position: absolute; inset: 0; pointer-events: none;
        background-image:
            linear-gradient(to right, rgba(14, 165, 233, 0.16) 0.5px, transparent 0.5px),
            linear-gradient(to bottom, rgba(14, 165, 233, 0.16) 0.5px, transparent 0.5px);
        background-size: var(--grid-step) var(--grid-step);
        background-position: var(--grid-ox) var(--grid-oy);
    }
    .smart-guide { position: absolute; pointer-events: none; z-index: 5; background: rgb(236, 72, 153); }
    .smart-guide.v { width: 1px; top: 0; bottom: 0; }
    .smart-guide.h { height: 1px; left: 0; right: 0; }
</style>

<div class="h-screen flex flex-col"
     x-data="designer()"
     :class="creating ? 'creating-mode' : ''"
     @@pointermove.window="onPointerMove($event)"
     @@pointerup.window="onPointerUp($event)"
     @@keydown.window="onKeyDown($event)">
    <!-- Header -->
    <header class="bg-white border-b border-slate-200 px-4 py-3 flex items-center justify-between shadow-sm gap-4">
        <div class="flex items-center gap-3 shrink-0">
            <div class="w-8 h-8 rounded bg-sky-600 flex items-center justify-center text-white font-bold">N</div>
            <div>
                <h1 class="text-sm font-semibold text-slate-900 leading-tight">NetReporter Designer</h1>
                <p class="text-xs text-slate-500 leading-tight">Editor de plantillas YAML · arrastrar y soltar · vista previa en vivo</p>
            </div>
        </div>

        <!-- Template controls -->
        <div class="flex items-center gap-2 text-xs">
            <select x-model="currentSelection"
                    @@change="onSelectionChange()"
                    class="border border-slate-300 rounded px-2 py-1 bg-white text-slate-800 min-w-[180px]">
                <option value="">(sin guardar)</option>
                <optgroup label="📦 Ejemplos" x-show="availableSamples.length > 0">
                    <template x-for="s in availableSamples" :key="s">
                        <option :value="'sample:' + s" x-text="s"></option>
                    </template>
                </optgroup>
                <optgroup label="Mis plantillas" x-show="availableTemplates.length > 0">
                    <template x-for="t in availableTemplates" :key="t">
                        <option :value="'user:' + t" x-text="t"></option>
                    </template>
                </optgroup>
            </select>
            <span x-show="isDirty" x-cloak
                  class="text-amber-600 font-bold"
                  title="Hay cambios sin guardar">●</span>
            <button type="button"
                    @@click="importFile()"
                    title="Importar archivo .yaml o .json desde disco"
                    class="px-2 py-1 border border-slate-300 rounded bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-500">
                ↥ Importar
            </button>
            <input type="file" id="import-input" accept=".yaml,.yml,.json" multiple
                   class="hidden" @@change="onImportFiles($event)">
            <button type="button"
                    @@click="saveTemplate()"
                    title="Guardar (Ctrl/Cmd+S)"
                class="px-2 py-1 border border-slate-300 rounded bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-500">
                Guardar
            </button>
            <button type="button"
                    @@click="saveAsTemplate()"
                    class="px-2 py-1 border border-slate-300 rounded bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-500">
                Guardar como…
            </button>
            <button type="button"
                    @@click="deleteTemplate()"
                    :disabled="!isUserTemplate"
                    :class="!isUserTemplate ? 'opacity-40 cursor-not-allowed' : 'hover:bg-red-50 hover:border-red-400'"
                    title="Eliminar la plantilla guardada"
                    class="px-2 py-1 border border-slate-300 rounded bg-white text-slate-700">
                Eliminar
            </button>
            <button type="button"
                    @@click="exportPdf()"
                    class="px-2 py-1 border border-sky-600 rounded bg-sky-600 text-white hover:bg-sky-700">
                ⭳ PDF
            </button>
            <button type="button"
                    @@click="exportHtml()"
                    class="px-2 py-1 border border-slate-700 rounded bg-slate-700 text-white hover:bg-slate-800">
                ⭳ HTML
            </button>
            <button type="button"
                    @@click="exportXlsx()"
                    class="px-2 py-1 border border-emerald-700 rounded bg-emerald-700 text-white hover:bg-emerald-800">
                ⭳ XLSX
            </button>
        </div>
        <div class="text-xs text-slate-500 flex items-center gap-3">
            <div class="flex items-center gap-1">
                <button type="button"
                        @@click="undo()"
                        :disabled="undoStack.length === 0"
                        :class="undoStack.length === 0 ? 'opacity-40 cursor-not-allowed' : 'hover:bg-slate-200'"
                        class="px-2 py-1 border border-slate-300 rounded text-xs bg-white text-slate-700"
                        title="Deshacer (Ctrl/Cmd+Z)">
                    ↶ <span class="hidden sm:inline">Deshacer</span>
                    <span class="text-[9px] text-slate-400" x-text="undoStack.length > 0 ? '(' + undoStack.length + ')' : ''"></span>
                </button>
                <button type="button"
                        @@click="redo()"
                        :disabled="redoStack.length === 0"
                        :class="redoStack.length === 0 ? 'opacity-40 cursor-not-allowed' : 'hover:bg-slate-200'"
                        class="px-2 py-1 border border-slate-300 rounded text-xs bg-white text-slate-700"
                        title="Rehacer (Ctrl/Cmd+Shift+Z)">
                    ↷ <span class="hidden sm:inline">Rehacer</span>
                    <span class="text-[9px] text-slate-400" x-text="redoStack.length > 0 ? '(' + redoStack.length + ')' : ''"></span>
                </button>
            </div>
            <span x-show="selected && !isMulti" x-cloak class="inline-flex items-center gap-1 bg-amber-100 text-amber-800 px-2 py-0.5 rounded">
                <span x-text="selected?.kind"></span>
                · <code x-text="selected?.path"></code>
            </span>
            <span x-show="isMulti" x-cloak class="inline-flex items-center gap-1 bg-amber-100 text-amber-800 px-2 py-0.5 rounded"
                  x-text="selection.length + ' elementos seleccionados'"></span>
            <span x-show="clipboard" x-cloak class="text-slate-400" title="Hay elementos en el portapapeles (Ctrl/Cmd+V para pegar)">📋</span>
            <span x-show="!selected" class="text-slate-400">Ningún elemento seleccionado</span>
            <div class="relative" @@click.outside="showHelp = false">
                <button type="button" @@click="showHelp = !showHelp"
                        class="w-6 h-6 rounded-full border border-slate-300 bg-white text-slate-600 hover:bg-sky-50 hover:border-sky-500"
                        title="Atajos de teclado (?)">?</button>
                <div x-show="showHelp" x-cloak x-transition.opacity
                     class="absolute right-0 top-8 z-50 w-72 bg-white border border-slate-200 rounded-lg shadow-xl p-3 text-[11px] text-slate-700">
                    <div class="font-semibold text-slate-900 mb-2">Atajos de teclado</div>
                    <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
                        <template x-for="h in shortcuts" :key="h[0]">
                            <div class="contents">
                                <dt><kbd class="px-1 bg-slate-100 border border-slate-200 rounded font-mono text-[10px]" x-text="h[0]"></kbd></dt>
                                <dd x-text="h[1]"></dd>
                            </div>
                        </template>
                    </dl>
                </div>
            </div>
        </div>
    </header>

    <!-- Rectángulo de selección por marco (rubber band) -->
    <div x-show="marquee && marquee.active"
         x-cloak
         class="fixed pointer-events-none border border-sky-500 bg-sky-400/10 z-40"
         :style="marquee ? `left:${Math.min(marquee.x0, marquee.x1)}px;top:${Math.min(marquee.y0, marquee.y1)}px;width:${Math.abs(marquee.x1 - marquee.x0)}px;height:${Math.abs(marquee.y1 - marquee.y0)}px` : ''"></div>

    <!-- Sugerencias de bindings a partir de data.json -->
    <datalist id="json-paths">
        <template x-for="p in jsonPaths" :key="p"><option :value="p"></option></template>
    </datalist>
    <datalist id="json-template-paths">
        <template x-for="p in jsonPaths" :key="p"><option :value="'{{ ' + p + ' }}'"></option></template>
    </datalist>
    <datalist id="json-array-paths">
        <template x-for="p in arrayPaths" :key="p"><option :value="p"></option></template>
    </datalist>
    <datalist id="json-row-paths">
        <template x-for="p in rowPaths" :key="p"><option :value="p"></option></template>
    </datalist>

    <!-- Ghost que sigue el cursor durante la creación -->
    <div x-show="creating"
         x-cloak
         class="fixed pointer-events-none bg-sky-600 text-white text-xs rounded px-2 py-1 shadow-lg z-50 select-none"
         :style="`left: ${creating?.x + 8}px; top: ${creating?.y + 8}px`"
         x-text="'+ ' + creating?.kind"></div>

    <!-- Tooltip de banda al hover del panel -->
    <div x-show="hoveredBand"
         x-cloak
         class="fixed pointer-events-none bg-slate-900 text-white text-[11px] rounded-md shadow-xl z-50 min-w-[220px] max-w-[260px]"
         :style="`left: ${hoveredBand?.anchorLeft}px; top: ${hoveredBand?.anchorTop}px`">
        <div class="px-3 py-2 border-b border-slate-700 flex items-center justify-between">
            <span class="font-semibold" x-text="bandLabel(hoveredBand?.kind) + ' · ' + hoveredBand?.kind"></span>
            <span class="text-slate-400 text-[10px]" x-text="'#' + hoveredBand?.index"></span>
        </div>
        <dl class="px-3 py-2 space-y-1 text-slate-200">
            <div class="flex justify-between gap-2">
                <dt class="text-slate-400">Alto declarado</dt>
                <dd class="font-mono" x-text="(hoveredBand?.declaredHeight || 0).toFixed(2) + ' pt'"></dd>
            </div>
            <div class="flex justify-between gap-2">
                <dt class="text-slate-400">Alto real</dt>
                <dd class="font-mono" x-text="(hoveredBand?.height || 0).toFixed(2) + ' pt'"></dd>
            </div>
            <div class="flex justify-between gap-2">
                <dt class="text-slate-400">Posición Y</dt>
                <dd class="font-mono" x-text="(hoveredBand?.y || 0).toFixed(2) + ' pt'"></dd>
            </div>
            <div class="flex justify-between gap-2">
                <dt class="text-slate-400">Elementos</dt>
                <dd class="font-mono" x-text="hoveredBand?.elementCount ?? 0"></dd>
            </div>
            <div class="flex justify-between gap-2">
                <dt class="text-slate-400">Path</dt>
                <dd class="font-mono text-slate-300" x-text="'bands.' + hoveredBand?.index"></dd>
            </div>
        </dl>
        <div x-show="(hoveredBand?.elementCount || 0) === 0"
             class="px-3 py-1.5 border-t border-slate-700 text-slate-400 text-[10px] italic">
            Sin elementos — la posición es estimada.
        </div>
    </div>

    <!-- Main: 3 columnas (editor | toolbox | preview) -->
    <div class="flex-1 flex overflow-hidden">
        <!-- Izquierda: editores con tabs -->
        <section class="flex flex-col bg-white shrink-0 overflow-hidden"
                 x-show="!editorCollapsed"
                 :style="`width: ${editorWidth}px`">
            <nav class="flex border-b border-slate-200 bg-slate-50 text-sm">
                <button type="button"
                        @@click="showTab('yaml')"
                        :class="tab === 'yaml' ? 'bg-white text-slate-900 border-b-2 border-sky-600' : 'text-slate-600 hover:text-slate-900'"
                        class="px-4 py-2 font-medium transition">
                    report.yaml
                </button>
                <button type="button"
                        @@click="showTab('json')"
                        :class="tab === 'json' ? 'bg-white text-slate-900 border-b-2 border-sky-600' : 'text-slate-600 hover:text-slate-900'"
                        class="px-4 py-2 font-medium transition">
                    data.json
                </button>
                <div class="ml-auto flex items-center px-2">
                    <span class="text-[10px] text-slate-400 mr-2 hidden xl:inline">Ctrl/⌘+F buscar · Alt+G ir a línea</span>
                    <button type="button" @@click="toggleEditor()"
                            class="w-7 h-7 rounded text-slate-500 hover:bg-slate-200 hover:text-slate-900"
                            title="Ocultar el editor (Ctrl/Cmd+B)">⇤</button>
                </div>
            </nav>

            <form id="editor-form"
                  class="flex-1 flex flex-col min-h-0"
                  hx-post="/Home/Preview"
                  hx-target="#preview"
                  hx-swap="innerHTML"
                  hx-trigger="input delay:700ms from:textarea, load"
                  hx-indicator="#preview-loader">

                <div x-show="tab === 'yaml'" class="cm-host" x-cloak>
                    <textarea id="yaml-editor" name="Yaml"
                              class="editor w-full h-full p-3 border-0 focus:ring-0 resize-none text-slate-900 bg-white outline-none"
                              spellcheck="false">@Model.Yaml</textarea>
                </div>

                <div x-show="tab === 'json'" class="cm-host">
                    <textarea id="json-editor" name="Json"
                              class="editor w-full h-full p-3 border-0 focus:ring-0 resize-none text-slate-900 bg-white outline-none"
                              spellcheck="false">@Model.Json</textarea>
                </div>
            </form>
        </section>

        <!-- Divisor redimensionable (doble clic: ancho por defecto) -->
        <div x-show="!editorCollapsed"
             class="w-1.5 shrink-0 cursor-col-resize bg-slate-200 hover:bg-sky-400 transition-colors"
             :class="resizingEditor ? 'bg-sky-500' : ''"
             title="Arrastra para cambiar el ancho del editor · doble clic para restablecer"
             @@pointerdown.prevent="startEditorResize($event)"
             @@dblclick="setEditorWidth(defaultEditorWidth())"></div>
        <!-- Riel visible con el editor oculto -->
        <div x-show="editorCollapsed" x-cloak
             class="w-8 shrink-0 bg-slate-50 border-r border-slate-200 flex flex-col items-center pt-2">
            <button type="button" @@click="toggleEditor()"
                    class="w-7 h-7 rounded text-slate-500 hover:bg-slate-200 hover:text-slate-900"
                    title="Mostrar el editor (Ctrl/Cmd+B)">⇥</button>
            <span class="mt-3 text-[10px] text-slate-400 tracking-wide [writing-mode:vertical-rl]">YAML · JSON</span>
        </div>

        <!-- Toolbox vertical -->
        <aside class="w-28 shrink-0 bg-slate-100 border-r border-slate-200 flex flex-col items-center py-3 gap-2 overflow-y-auto">
            <div class="text-[10px] uppercase text-slate-500 tracking-wide mb-1">Insertar</div>
            <template x-for="tool in tools" :key="tool.kind">
                <button type="button"
                        class="toolbox-item w-20 h-12 rounded border border-slate-300 bg-white hover:border-sky-500 hover:bg-sky-50 flex flex-col items-center justify-center gap-1 text-[10px] text-slate-700 select-none touch-none"
                        :class="creating?.kind === tool.kind ? 'border-sky-600 bg-sky-100' : ''"
                        :title="'Arrastra a una banda para insertar: ' + tool.label"
                        @@pointerdown.prevent="onToolPointerDown($event, tool.kind)">
                    <span x-text="tool.icon" class="text-lg leading-none"></span>
                    <span x-text="tool.label"></span>
                </button>
            </template>
            <div class="mt-1 text-[10px] text-slate-400 text-center leading-tight px-1">
                Arrastra a una banda
            </div>

            <!-- Panel de bandas -->
            <div class="mt-3 w-full border-t border-slate-300 pt-3 px-2">
                <div class="text-[10px] uppercase text-slate-500 tracking-wide mb-2 text-center">Bandas</div>
                <template x-for="(b, idx) in bands" :key="b.index">
                    <div class="flex items-center gap-0.5 mb-1 rounded px-0.5 py-0.5"
                         :class="hoveredBand?.index === b.index ? 'bg-sky-100' : ''"
                         @@mouseenter="showBandTooltip(b, $event)"
                         @@mouseleave="hoveredBand = null">
                        <span class="flex-1 text-[11px] leading-tight text-slate-700 truncate" x-text="bandShortLabel(b.kind)"></span>
                        <button type="button"
                                @@click="moveBandUp(b.index)"
                                :disabled="idx === 0"
                                :class="idx === 0 ? 'opacity-20 cursor-not-allowed' : 'hover:text-slate-900'"
                                class="text-[10px] text-slate-500 px-0.5"
                                title="Subir">▲</button>
                        <button type="button"
                                @@click="moveBandDown(b.index)"
                                :disabled="idx === bands.length - 1"
                                :class="idx === bands.length - 1 ? 'opacity-20 cursor-not-allowed' : 'hover:text-slate-900'"
                                class="text-[10px] text-slate-500 px-0.5"
                                title="Bajar">▼</button>
                        <button type="button"
                                @@click="deleteBand(b.index)"
                                class="text-[10px] text-red-500 hover:text-red-700 px-0.5"
                                title="Eliminar banda">✕</button>
                    </div>
                </template>

                <div class="mt-2">
                    <select x-model="newBandKind"
                            class="w-full text-[11px] border border-slate-300 rounded py-0.5 px-1 mb-1 bg-white">
                        <option value="ReportHeader">Encabezado de reporte</option>
                        <option value="PageHeader">Encabezado de página</option>
                        <option value="Detail">Detalle</option>
                        <option value="PageFooter">Pie de página</option>
                        <option value="ReportFooter">Pie de reporte</option>
                    </select>
                    <button type="button"
                            @@click="addBand()"
                            class="w-full text-[11px] bg-sky-600 text-white rounded px-1.5 py-1 hover:bg-sky-700">
                        + Banda
                    </button>
                </div>
            </div>
        </aside>

        <!-- Derecha: preview + drawer de propiedades -->
        <!-- min-w-0 es CRÍTICO: sin él, el contenido escalado del preview empuja el flex
             item haciendo que invada el editor YAML/toolbox cuando hacemos zoom-in. -->
        <section class="flex-1 min-w-0 flex flex-col bg-slate-200 relative">
            <div class="flex items-center justify-between px-4 py-2 border-b border-slate-300 bg-slate-100 text-sm">
                <div class="flex items-center gap-3">
                    <span class="font-medium text-slate-700">Vista previa</span>
                    <div class="flex items-center gap-1 text-xs">
                        <button type="button"
                                @@click="zoomOut()"
                                title="Alejar (Ctrl/Cmd + -)"
                                class="w-6 h-6 flex items-center justify-center border border-slate-300 rounded bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-500 leading-none">−</button>
                        <span class="w-12 text-center font-mono text-slate-700"
                              x-text="Math.round(zoom * 100) + '%'"></span>
                        <button type="button"
                                @@click="zoomIn()"
                                title="Acercar (Ctrl/Cmd + +)"
                                class="w-6 h-6 flex items-center justify-center border border-slate-300 rounded bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-500 leading-none">+</button>
                        <button type="button"
                                @@click="zoomReset()"
                                title="100% (Ctrl/Cmd + 0)"
                                class="px-1.5 h-6 flex items-center border border-slate-300 rounded bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-500 leading-none">1:1</button>
                        <button type="button"
                                @@click="zoomFitWidth()"
                                title="Ajustar al ancho"
                                class="w-6 h-6 flex items-center justify-center border border-slate-300 rounded bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-500 leading-none">↔</button>
                        <button type="button"
                                @@click="zoomFitPage()"
                                title="Página completa"
                                class="w-6 h-6 flex items-center justify-center border border-slate-300 rounded bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-500 leading-none">⤢</button>
                    </div>
                    <div class="flex items-center gap-1 text-xs" x-show="pageCount > 0" x-cloak>
                        <span class="w-px h-5 bg-slate-300 mx-1"></span>
                        <button type="button" @@click="goToPage(currentPage - 1)" :disabled="currentPage <= 1"
                                title="Página anterior (PgUp)"
                                class="w-6 h-6 flex items-center justify-center border border-slate-300 rounded bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-500 disabled:opacity-40 disabled:hover:bg-white">‹</button>
                        <input type="text" inputmode="numeric"
                               :value="currentPage"
                               @@change="goToPage(parseInt($event.target.value, 10)); $event.target.value = currentPage"
                               @@keydown.enter="$event.target.blur()"
                               @@focus="$event.target.select()"
                               aria-label="Página"
                               class="w-9 h-6 text-center border border-slate-300 rounded bg-white font-mono text-slate-700">
                        <span class="text-slate-500 whitespace-nowrap" x-text="'de ' + pageCount"></span>
                        <button type="button" @@click="goToPage(currentPage + 1)" :disabled="currentPage >= pageCount"
                                title="Página siguiente (PgDn)"
                                class="w-6 h-6 flex items-center justify-center border border-slate-300 rounded bg-white text-slate-700 hover:bg-sky-50 hover:border-sky-500 disabled:opacity-40 disabled:hover:bg-white">›</button>
                    </div>
                    <span class="w-px h-5 bg-slate-300"></span>
                    <div class="flex items-center gap-1 text-xs">
                        <button type="button" @@click="toggleRulers()"
                                :class="showRulers ? 'bg-slate-700 text-white border-slate-700' : 'bg-white text-slate-700 border-slate-300 hover:bg-sky-50 hover:border-sky-500'"
                                title="Reglas (R)" class="px-1.5 h-6 border rounded leading-none">📏</button>
                        <button type="button" @@click="toggleGrid()"
                                :class="showGrid ? 'bg-slate-700 text-white border-slate-700' : 'bg-white text-slate-700 border-slate-300 hover:bg-sky-50 hover:border-sky-500'"
                                title="Cuadrícula (G) — Shift al arrastrar ajusta a ella" class="px-1.5 h-6 border rounded leading-none font-mono">#</button>
                        <select x-model.number="gridStep" @@change="applyGridToDom(); persistGuides()"
                                title="Paso de la cuadrícula y del ajuste con Shift"
                                class="h-6 border border-slate-300 rounded bg-white text-slate-700 text-xs px-1">
                            <option value="5">5 pt</option>
                            <option value="10">10 pt</option>
                            <option value="20">20 pt</option>
                            <option value="28.3465">1 cm</option>
                        </select>
                        <button type="button" @@click="smartGuides = !smartGuides; persistGuides()"
                                :class="smartGuides ? 'bg-slate-700 text-white border-slate-700' : 'bg-white text-slate-700 border-slate-300 hover:bg-sky-50 hover:border-sky-500'"
                                title="Guías inteligentes al arrastrar (Alt las desactiva momentáneamente)"
                                class="px-1.5 h-6 border rounded leading-none">⌖</button>
                    </div>
                    <span class="w-px h-5 bg-slate-300"></span>
                    <button type="button" @@click="toggleCleanView()"
                            :class="cleanView ? 'bg-sky-600 text-white border-sky-600 hover:bg-sky-700' : 'bg-white text-slate-700 border-slate-300 hover:bg-sky-50 hover:border-sky-500'"
                            title="Vista limpia: oculta los marcos de edición para ver el reporte tal cual (V)"
                            class="px-2 h-6 flex items-center gap-1 border rounded text-xs leading-none">👁 <span class="hidden lg:inline">Vista limpia</span></button>
                </div>
                <span id="preview-loader" class="htmx-indicator text-xs text-sky-700 flex items-center gap-1">
                    <svg class="animate-spin w-3 h-3" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" stroke-opacity="0.25"/>
                        <path fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"/>
                    </svg>
                    <span x-text="busyLabel">Renderizando…</span>
                </span>
            </div>

            <div class="flex-1 min-w-0 min-h-0 grid"
                 :style="showRulers ? 'grid-template-columns: 22px minmax(0, 1fr); grid-template-rows: 22px minmax(0, 1fr)' : 'grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr)'">
                <button type="button" x-show="showRulers" @@click="cycleRulerUnit()"
                        class="bg-slate-100 border-r border-b border-slate-300 text-[9px] text-slate-500 hover:text-slate-900 font-mono"
                        title="Unidad de las reglas (clic para cambiar). El 0 es el origen del contenido (márgenes)."
                        x-text="rulerUnit"></button>
                <canvas id="ruler-x" x-show="showRulers" class="block w-full h-[22px] bg-slate-100 border-b border-slate-300"></canvas>
                <canvas id="ruler-y" x-show="showRulers" class="block h-full w-[22px] bg-slate-100 border-r border-slate-300"></canvas>
            <div id="preview"
                 class="min-w-0 min-h-0 overflow-auto p-6"
                 :class="cleanView ? 'clean-view' : ''"
                 @@scroll.passive="onPreviewScroll()"
                 @@wheel="onPreviewWheel($event)"
                 @@pointermove="onPreviewHover($event)"
                 @@pointerleave="rulerCursor = null; drawRulers()"
                 @@pointerdown="onOverlayPointerDown($event)">
                <p class="text-sm text-slate-500 text-center mt-8">Cargando preview…</p>
            </div>
            </div>

            <!-- Drawer de propiedades del elemento seleccionado -->
            <aside x-show="selected"
                   x-cloak
                   x-transition:enter="transition ease-out duration-150"
                   x-transition:enter-start="translate-x-2 opacity-0"
                   x-transition:enter-end="translate-x-0 opacity-100"
                   class="absolute top-12 right-4 w-72 bg-white rounded-lg shadow-lg border border-slate-200 text-sm flex flex-col"
                   style="max-height: calc(100vh - 6rem);">
                <header class="flex items-center justify-between px-3 py-2 bg-slate-50 border-b border-slate-200 shrink-0 rounded-t-lg">
                    <div class="font-semibold text-slate-800" x-text="isMulti ? 'Selección múltiple' : 'Propiedades'"></div>
                    <div class="flex items-center gap-1">
                        <button type="button"
                                @@click="deleteSelection()"
                                class="text-red-500 hover:text-red-700 text-base leading-none"
                                title="Eliminar (Del)">🗑</button>
                        <button type="button"
                                @@click="clearSelection()"
                                class="text-slate-400 hover:text-slate-700"
                                title="Cerrar">✕</button>
                    </div>
                </header>

                <!-- Panel de selección múltiple -->
                <div class="p-3 space-y-3 overflow-y-auto flex-1" x-show="isMulti">
                    <ul class="text-[11px] text-slate-600 space-y-0.5 max-h-32 overflow-y-auto">
                        <template x-for="item in selection" :key="item.path">
                            <li class="flex items-center gap-1">
                                <span class="px-1 bg-amber-100 text-amber-800 rounded uppercase text-[9px]" x-text="item.kind"></span>
                                <code class="text-slate-700" x-text="item.path"></code>
                            </li>
                        </template>
                    </ul>
                    <fieldset class="border border-slate-200 rounded p-2">
                        <legend class="text-[10px] uppercase text-slate-500 px-1">Alinear</legend>
                        <div class="grid grid-cols-3 gap-1 text-[11px]">
                            <button type="button" @@click="alignSelection('left')"    class="border border-slate-300 rounded py-1 hover:bg-sky-50" title="Alinear a la izquierda">⇤ Izq.</button>
                            <button type="button" @@click="alignSelection('hcenter')" class="border border-slate-300 rounded py-1 hover:bg-sky-50" title="Centrar horizontalmente">↔ Centro</button>
                            <button type="button" @@click="alignSelection('right')"   class="border border-slate-300 rounded py-1 hover:bg-sky-50" title="Alinear a la derecha">⇥ Der.</button>
                            <button type="button" @@click="alignSelection('top')"     class="border border-slate-300 rounded py-1 hover:bg-sky-50" title="Alinear arriba">⤒ Arriba</button>
                            <button type="button" @@click="alignSelection('vmiddle')" class="border border-slate-300 rounded py-1 hover:bg-sky-50" title="Centrar verticalmente">↕ Medio</button>
                            <button type="button" @@click="alignSelection('bottom')"  class="border border-slate-300 rounded py-1 hover:bg-sky-50" title="Alinear abajo">⤓ Abajo</button>
                        </div>
                    </fieldset>
                    <div class="grid grid-cols-3 gap-1 text-[11px]">
                        <button type="button" @@click="copySelection()"      class="border border-slate-300 rounded py-1 hover:bg-sky-50" title="Ctrl/Cmd+C">📋 Copiar</button>
                        <button type="button" @@click="duplicateSelection()" class="border border-slate-300 rounded py-1 hover:bg-sky-50" title="Ctrl/Cmd+D">⧉ Duplicar</button>
                        <button type="button" @@click="deleteSelection()"    class="border border-red-300 text-red-600 rounded py-1 hover:bg-red-50" title="Del">🗑 Borrar</button>
                    </div>
                    <p class="text-[10px] text-slate-400">Arrastra cualquiera para mover el grupo · flechas para nudge · Shift+clic para quitar/agregar.</p>
                </div>

                <div class="p-3 space-y-3 overflow-y-auto flex-1" x-show="selected && !isMulti">
                    <div class="text-xs text-slate-500">
                        <code x-text="selected?.path" class="block text-slate-700"></code>
                        <span class="inline-block mt-1 px-1.5 py-0.5 bg-amber-100 text-amber-800 rounded uppercase tracking-wide text-[10px]"
                              x-text="selected?.kind"></span>
                    </div>

                    <!-- Bounds -->
                    <fieldset class="border border-slate-200 rounded p-2">
                        <legend class="text-[10px] uppercase text-slate-500 px-1">Posición y tamaño (pt)</legend>
                        <div class="grid grid-cols-2 gap-2">
                            <label class="flex flex-col text-[11px] text-slate-600">
                                X
                                <input type="number" step="0.5"
                                       x-model.number="form.x"
                                       @@input.debounce.400ms="applyPatch({X: form.x})"
                                       class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm text-slate-900">
                            </label>
                            <label class="flex flex-col text-[11px] text-slate-600">
                                Y
                                <input type="number" step="0.5"
                                       x-model.number="form.y"
                                       @@input.debounce.400ms="applyPatch({Y: form.y})"
                                       class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm text-slate-900">
                            </label>
                            <label class="flex flex-col text-[11px] text-slate-600">
                                Ancho
                                <input type="number" step="0.5"
                                       x-model.number="form.width"
                                       @@input.debounce.400ms="applyPatch({Width: form.width})"
                                       class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm text-slate-900">
                            </label>
                            <label class="flex flex-col text-[11px] text-slate-600">
                                Alto
                                <input type="number" step="0.5"
                                       x-model.number="form.height"
                                       @@input.debounce.400ms="applyPatch({Height: form.height})"
                                       class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm text-slate-900">
                            </label>
                        </div>
                    </fieldset>

                    <!-- Visibilidad condicional (todos los kinds) -->
                    <label class="flex flex-col text-[11px] text-slate-600">
                        Visible si… <span class="text-[10px] text-slate-400">(expresión; vacío = siempre)</span>
                        <input type="text" x-model="form.visible"
                               @@change="applyPatch({Visible: form.visible || ' '})"
                               placeholder="$.descuento > 0"
                               class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm font-mono">
                    </label>

                    <!-- Estilo (text + rectangle + chart) -->
                    <label x-show="['text', 'rectangle', 'chart'].includes(selected?.kind)"
                           class="flex flex-col text-[11px] text-slate-600">
                        Estilo
                        <input type="text" list="style-names"
                               x-model="form.style"
                               @@input.debounce.400ms="applyPatch({Style: form.style})"
                               class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm text-slate-900"
                               placeholder="Default">
                    </label>

                    <!-- Contenido (text) -->
                    <label x-show="selected?.kind === 'text'"
                           class="flex flex-col text-[11px] text-slate-600">
                        Contenido
                        <textarea rows="3"
                                  x-model="form.content"
                                  @@input.debounce.400ms="applyPatch({Content: form.content})"
                                  class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm text-slate-900 font-mono"></textarea>
                        <span class="text-[10px] text-slate-400 mt-0.5">
                            Soporta <code>{{ $.path }}</code>, <code>{{ pageNumber }}</code> y expresiones:
                            <code>{{ $.total * 1.15 : N2 }}</code>, <code>{{ upper($.nombre) }}</code>,
                            <code>{{ $.saldo == 0 ? 'PAGADO' : 'PENDIENTE' }}</code>.
                        </span>
                    </label>

                    <!-- Línea: color + grosor -->
                    <template x-if="selected?.kind === 'line'">
                        <div class="grid grid-cols-2 gap-2">
                            <label class="flex flex-col text-[11px] text-slate-600">
                                Color
                                <input type="color"
                                       x-model="form.color"
                                       @@input.debounce.400ms="applyPatch({Color: form.color})"
                                       class="mt-0.5 border border-slate-300 rounded h-8">
                            </label>
                            <label class="flex flex-col text-[11px] text-slate-600">
                                Grosor
                                <input type="number" step="0.1" min="0.1"
                                       x-model.number="form.thickness"
                                       @@input.debounce.400ms="applyPatch({Thickness: form.thickness})"
                                       class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm text-slate-900">
                            </label>
                        </div>
                    </template>

                    <!-- Rectángulo: fill + esquinas -->
                    <div x-show="selected?.kind === 'rectangle'" class="grid grid-cols-2 gap-2">
                        <label class="flex flex-col text-[11px] text-slate-600">
                            Relleno
                            <input type="color"
                                   x-model="form.fill"
                                   @@input.debounce.400ms="applyPatch({Fill: form.fill})"
                                   class="mt-0.5 border border-slate-300 rounded h-8">
                        </label>
                        <label class="flex flex-col text-[11px] text-slate-600">
                            Radio esquinas
                            <input type="number" step="1" min="0"
                                   x-model.number="form.cornerRadius"
                                   @@input.debounce.400ms="applyPatch({CornerRadius: form.cornerRadius || 0})"
                                   class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm">
                        </label>
                    </div>

                    <!-- Imagen: picker -->
                    <template x-if="selected?.kind === 'image'">
                        <div class="space-y-2">
                            <div class="flex items-center gap-2">
                                <button type="button" @@click="document.getElementById('image-upload').click()"
                                        class="flex-1 text-[11px] bg-sky-600 text-white rounded px-2 py-1.5 hover:bg-sky-700">
                                    🖼 Elegir imagen…
                                </button>
                                <input type="file" id="image-upload" accept="image/png,image/jpeg,image/gif,image/webp"
                                       class="hidden" @@change="onImageFileChosen($event)">
                            </div>
                            <p class="text-[10px] text-slate-500" x-show="form.source === 'data:'">
                                Imagen embebida en el template (data URI). También puedes usar un path o un template:
                            </p>
                            <label class="flex flex-col text-[11px] text-slate-600">
                                Origen (ruta o plantilla)
                                <input type="text" list="json-template-paths"
                                       :value="form.source === 'data:' ? '' : form.source"
                                       @@change="form.source = $event.target.value; applyPatch({Source: form.source})"
                                       placeholder="logo.png o {{ $.logo }}"
                                       class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm font-mono">
                            </label>
                            <label class="flex flex-col text-[11px] text-slate-600">
                                Ajuste
                                <select x-model="form.fit" @@change="applyPatch({Fit: form.fit})"
                                        class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm bg-white">
                                    <option value="contain">contain (mantener proporción)</option>
                                    <option value="fill">fill (estirar)</option>
                                </select>
                            </label>
                        </div>
                    </template>

                    <!-- Barcode: picker -->
                    <template x-if="selected?.kind === 'barcode'">
                        <div class="space-y-2">
                            <label class="flex flex-col text-[11px] text-slate-600">
                                Formato
                                <select x-model="form.barcodeFormat" @@change="applyPatch({BarcodeFormat: form.barcodeFormat})"
                                        class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm bg-white">
                                    <option value="qr">QR</option>
                                    <option value="code128">Code 128</option>
                                    <option value="code39">Code 39</option>
                                    <option value="ean13">EAN-13 (12–13 dígitos)</option>
                                </select>
                            </label>
                            <label class="flex flex-col text-[11px] text-slate-600">
                                Valor (texto o template)
                                <input type="text" list="json-template-paths"
                                       x-model="form.value"
                                       @@input.debounce.500ms="applyPatch({Value: form.value})"
                                       class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm font-mono">
                            </label>
                            <div class="grid grid-cols-2 gap-2">
                                <label class="flex flex-col text-[11px] text-slate-600">
                                    Color
                                    <input type="color" x-model="form.barcodeForeground"
                                           @@input.debounce.400ms="applyPatch({BarcodeForeground: form.barcodeForeground})"
                                           class="mt-0.5 border border-slate-300 rounded h-8">
                                </label>
                                <label class="flex flex-col text-[11px] text-slate-600">
                                    Fondo
                                    <input type="color" x-model="form.barcodeBackground"
                                           @@input.debounce.400ms="applyPatch({BarcodeBackground: form.barcodeBackground})"
                                           class="mt-0.5 border border-slate-300 rounded h-8">
                                </label>
                            </div>
                        </div>
                    </template>

                    <!-- Chart -->
                    <template x-if="selected?.kind === 'chart'">
                        <div class="space-y-2">
                            <div class="grid grid-cols-2 gap-2">
                                <label class="flex flex-col text-[11px] text-slate-600">
                                    Tipo
                                    <select x-model="form.chartType" @@change="applyPatch({ChartType: form.chartType})"
                                            class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm bg-white">
                                        <option value="bar">Barras</option>
                                        <option value="horizontalBar">Barras horiz.</option>
                                        <option value="line">Líneas</option>
                                        <option value="area">Área</option>
                                        <option value="pie">Pastel</option>
                                        <option value="donut">Dona</option>
                                    </select>
                                </label>
                                <label class="flex flex-col text-[11px] text-slate-600">
                                    Leyenda
                                    <select x-model="form.legend" @@change="applyPatch({Legend: form.legend || 'auto'})"
                                            class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm bg-white">
                                        <option value="">auto</option>
                                        <option value="none">ninguna</option>
                                        <option value="top">arriba</option>
                                        <option value="bottom">abajo</option>
                                        <option value="right">derecha</option>
                                    </select>
                                </label>
                            </div>
                            <label class="flex flex-col text-[11px] text-slate-600">
                                Título
                                <input type="text" x-model="form.title"
                                       @@input.debounce.500ms="applyPatch({Title: form.title || ' '})"
                                       class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm">
                            </label>
                            <label class="flex flex-col text-[11px] text-slate-600">
                                Filas (JSON Path al array)
                                <input type="text" list="json-array-paths" x-model="form.rows"
                                       @@change="refreshRowPaths(form.rows); applyPatch({Rows: form.rows})"
                                       class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm font-mono">
                            </label>
                            <label class="flex flex-col text-[11px] text-slate-600">
                                Categoría (por fila)
                                <input type="text" list="json-row-paths" x-model="form.category"
                                       @@change="applyPatch({Category: form.category})"
                                       class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm font-mono">
                            </label>
                            <div class="flex flex-wrap gap-x-3 gap-y-1 text-[11px] text-slate-600">
                                <label class="flex items-center gap-1"><input type="checkbox" x-model="form.showValues" @@change="applyPatch({ShowValues: form.showValues})"> valores</label>
                                <label class="flex items-center gap-1"><input type="checkbox" x-model="form.showPercent" @@change="applyPatch({ShowPercent: form.showPercent})"> %</label>
                                <label class="flex items-center gap-1"><input type="checkbox" x-model="form.stacked" @@change="applyPatch({Stacked: form.stacked})"> apilado</label>
                            </div>
                            <label class="flex flex-col text-[11px] text-slate-600">
                                Formato de valores
                                <input type="text" x-model="form.valueFormat" placeholder="N0, C0, 0.0"
                                       @@input.debounce.500ms="applyPatch({ValueFormat: form.valueFormat || ' '})"
                                       class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm">
                            </label>
                            <div class="border border-slate-200 rounded p-1.5 space-y-1.5">
                                <div class="flex items-center justify-between">
                                    <span class="text-[10px] uppercase text-slate-500 tracking-wide">
                                        Series (<span x-text="form.series.length"></span>)
                                    </span>
                                    <button type="button" @@click="addSeries()"
                                            class="text-[10px] bg-sky-600 text-white rounded px-2 py-0.5 hover:bg-sky-700">+ serie</button>
                                </div>
                                <template x-for="(se, idx) in form.series" :key="idx">
                                    <div class="border border-slate-200 rounded bg-slate-50 p-1 space-y-1">
                                        <div class="flex items-center gap-1">
                                            <input type="color" x-model="se.color" @@change="flushSeries()"
                                                   class="w-6 h-6 border border-slate-300 rounded shrink-0" title="Color">
                                            <input type="text" x-model="se.name" placeholder="Nombre"
                                                   @@input.debounce.500ms="flushSeries()"
                                                   class="flex-1 min-w-0 border border-slate-300 rounded px-1 py-0.5 text-[11px] bg-white">
                                            <button type="button" @@click="removeSeries(idx)" :disabled="form.series.length === 1"
                                                    class="text-[10px] text-red-500 hover:text-red-700 px-0.5 disabled:opacity-30">✕</button>
                                        </div>
                                        <input type="text" list="json-row-paths" x-model="se.value" placeholder="$.total o = $.a * $.b"
                                               @@change="flushSeries()"
                                               class="w-full border border-slate-300 rounded px-1 py-0.5 text-[11px] font-mono bg-white">
                                    </div>
                                </template>
                            </div>
                        </div>
                    </template>

                    <!-- Tabla: rows path + config -->
                    <template x-if="selected?.kind === 'table'">
                        <div class="space-y-2">
                            <label class="flex flex-col text-[11px] text-slate-600">
                                Filas (JSON Path al array)
                                <input type="text" list="json-array-paths"
                                       x-model="form.rows"
                                       @@input.debounce.400ms="refreshRowPaths(form.rows); applyPatch({Rows: form.rows})"
                                       placeholder="$.items"
                                       class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm font-mono text-slate-900">
                            </label>

                            <div class="grid grid-cols-2 gap-2">
                                <label class="flex flex-col text-[11px] text-slate-600">
                                    Alto encabezado
                                    <input type="number" step="1" min="1"
                                           x-model.number="form.headerHeight"
                                           @@input.debounce.400ms="applyPatch({HeaderHeight: form.headerHeight})"
                                           class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm">
                                </label>
                                <label class="flex flex-col text-[11px] text-slate-600">
                                    Alto de fila
                                    <input type="number" step="1" min="1"
                                           x-model.number="form.rowHeight"
                                           @@input.debounce.400ms="applyPatch({RowHeight: form.rowHeight})"
                                           class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm">
                                </label>
                            </div>

                            <label class="flex flex-col text-[11px] text-slate-600">
                                Encabezado
                                <select x-model="form.headerMode"
                                        @@change="applyPatch({HeaderMode: form.headerMode})"
                                        class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm bg-white">
                                    <option value="RepeatOnPageBreak">Repetir en cada página</option>
                                    <option value="PrintOnce">Solo la primera vez</option>
                                </select>
                            </label>

                            <label class="flex flex-col text-[11px] text-slate-600">
                                Estilo del encabezado
                                <input type="text" list="style-names"
                                       x-model="form.headerStyle"
                                       @@input.debounce.400ms="applyPatch({HeaderStyle: form.headerStyle})"
                                       placeholder="TableHeader"
                                       class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm">
                            </label>

                            <label class="flex flex-col text-[11px] text-slate-600">
                                Estilo de fila
                                <input type="text" list="style-names"
                                       x-model="form.rowStyle"
                                       @@input.debounce.400ms="applyPatch({RowStyle: form.rowStyle})"
                                       placeholder="TableRow"
                                       class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm">
                            </label>

                            <label class="flex flex-col text-[11px] text-slate-600">
                                Estilo de fila alterna (opcional)
                                <input type="text" list="style-names"
                                       x-model="form.alternateRowStyle"
                                       @@input.debounce.400ms="applyPatch({AlternateRowStyle: form.alternateRowStyle})"
                                       placeholder="TableRowAlt"
                                       class="mt-0.5 border border-slate-300 rounded px-2 py-1 text-sm">
                            </label>

                            <!-- Editor de columnas -->
                            <div class="border border-slate-200 rounded p-1.5 space-y-1.5">
                                <div class="flex items-center justify-between">
                                    <span class="text-[10px] uppercase text-slate-500 tracking-wide">
                                        Columnas (<span x-text="form.columns.length"></span>)
                                    </span>
                                    <button type="button"
                                            @@click="addColumn()"
                                            class="text-[10px] bg-sky-600 text-white rounded px-2 py-0.5 hover:bg-sky-700">
                                        + columna
                                    </button>
                                </div>
                                <template x-for="(col, idx) in form.columns" :key="idx">
                                    <div class="border border-slate-200 rounded bg-slate-50">
                                        <!-- Fila compacta siempre visible -->
                                        <div class="flex items-center gap-0.5 p-1">
                                            <button type="button"
                                                    @@click="col.expanded = !col.expanded"
                                                    class="text-[10px] text-slate-500 hover:text-slate-900 w-3 text-center shrink-0"
                                                    :title="col.expanded ? 'Contraer' : 'Expandir'"
                                                    x-text="col.expanded ? '▼' : '▶'"></button>
                                            <input type="text" x-model="col.header"
                                                   @@input.debounce.400ms="flushColumns()"
                                                   placeholder="Encabezado"
                                                   class="flex-1 border border-slate-300 rounded px-1 py-0.5 text-[11px] bg-white min-w-0">
                                            <input type="number" step="1" min="1"
                                                   x-model.number="col.width"
                                                   @@input.debounce.400ms="flushColumns()"
                                                   title="Ancho (pt)"
                                                   class="w-10 border border-slate-300 rounded px-1 py-0.5 text-[11px] bg-white shrink-0">
                                            <button type="button" @@click="moveColumn(idx, -1)"
                                                    :disabled="idx === 0"
                                                    :class="idx === 0 ? 'opacity-20 cursor-not-allowed' : 'hover:text-slate-900'"
                                                    class="text-[10px] text-slate-500 px-0.5">▲</button>
                                            <button type="button" @@click="moveColumn(idx, 1)"
                                                    :disabled="idx === form.columns.length - 1"
                                                    :class="idx === form.columns.length - 1 ? 'opacity-20 cursor-not-allowed' : 'hover:text-slate-900'"
                                                    class="text-[10px] text-slate-500 px-0.5">▼</button>
                                            <button type="button" @@click="removeColumn(idx)"
                                                    class="text-[10px] text-red-500 hover:text-red-700 px-0.5">✕</button>
                                        </div>
                                        <!-- Detalles solo cuando expandida -->
                                        <div x-show="col.expanded" x-cloak class="px-1 pb-1 space-y-0.5 border-t border-slate-200 pt-1">
                                            <label class="block text-[9px] uppercase text-slate-500 tracking-wide">Valor (binding)</label>
                                            <input type="text" x-model="col.binding" list="json-row-paths"
                                                   @@input.debounce.400ms="flushColumns()"
                                                   placeholder="$.campo o = $.a * $.b"
                                                   class="w-full border border-slate-300 rounded px-1 py-0.5 text-[11px] font-mono bg-white">
                                            <div class="grid grid-cols-2 gap-0.5 mt-1">
                                                <div>
                                                    <label class="block text-[9px] uppercase text-slate-500 tracking-wide">Formato</label>
                                                    <input type="text" x-model="col.format"
                                                           @@input.debounce.400ms="flushColumns()"
                                                           placeholder="N2, dd/MM/yyyy"
                                                           class="w-full border border-slate-300 rounded px-1 py-0.5 text-[11px] bg-white">
                                                </div>
                                                <div>
                                                    <label class="block text-[9px] uppercase text-slate-500 tracking-wide">Alineación</label>
                                                    <select x-model="col.align"
                                                            @@change="flushColumns()"
                                                            class="w-full border border-slate-300 rounded px-1 py-0.5 text-[11px] bg-white">
                                                        <option value="left">Izquierda</option>
                                                        <option value="center">Centro</option>
                                                        <option value="right">Derecha</option>
                                                        <option value="justify">Justificado</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </template>
                </div>
            </aside>
        </section>
    </div>
</div>

<style>
    .htmx-indicator { opacity: 0; transition: opacity 200ms; }
    .htmx-request .htmx-indicator { opacity: 1; }
    .htmx-request.htmx-indicator { opacity: 1; }
</style>

<script>
    // Instancias de CodeMirror fuera del estado de Alpine: Alpine envuelve en proxies reactivos todo lo
    // que vive en data(), y CodeMirror no tolera eso. Los <textarea> siguen siendo la fuente que leen
    // HTMX (hx-post del form) y los exports; cada cambio del editor se copia ahí con cm.save().
    const EDITORS = { yaml: null, json: null };
    const EDITOR_STATE = { yamlLines: {}, linked: null, error: null, cursorTimer: null, programmatic: false };

    function designer() {
        return {
            tab: 'yaml',
            selected: null,
            dragging: null,
            resizing: null,
            creating: null,          // { kind, x, y } durante drag desde toolbox
            moving: false,
            saving: false,
            form: {
                x: 0, y: 0, width: 0, height: 0,
                style: '', content: '', color: '#000000', thickness: 0.5, fill: '#ffffff',
                rows: '', headerMode: 'RepeatOnPageBreak', headerHeight: 22, rowHeight: 18,
                headerStyle: '', rowStyle: '', alternateRowStyle: '', columnCount: 0,
                columns: [],
                visible: '', cornerRadius: 0,
                source: '', fit: 'contain',
                value: '', barcodeFormat: 'qr', barcodeForeground: '#000000', barcodeBackground: '#ffffff',
                chartType: 'bar', category: '', title: '', legend: '', showValues: false, showPercent: false,
                stacked: false, valueFormat: '', series: []
            },
            // Multi-selección: [{ path, kind }]. `selected` es el elemento "primario" (el del drawer).
            selection: [],
            marquee: null,           // { x0, y0, x1, y1, active, additive } en viewport-px
            clipboard: null,         // YAML de /Home/Copy
            clipboardFromCut: false,
            CLIPBOARD_STORAGE_KEY: 'netreporter.designer.clipboard',
            jsonPaths: [], arrayPaths: [], rowPaths: [],
            MIN_SIZE: 4,
            MAX_HISTORY: 50,
            zoom: 1,
            ZOOM_LEVELS: [0.25, 0.5, 0.75, 1, 1.25, 1.5, 2, 3, 4],
            ZOOM_MIN: 0.25,
            ZOOM_MAX: 4,
            ZOOM_STORAGE_KEY: 'netreporter.designer.zoom',
            undoStack: [],
            redoStack: [],
            pendingNudge: null,
            nudgeTimeout: null,
            availableTemplates: [],
            availableSamples: [],
            currentSelection: '',     // "" | "sample:<name>" | "user:<name>"
            isDirty: false,

            get currentTemplate()    { return this.currentSelection.startsWith('user:') ? this.currentSelection.slice(5) : ''; },
            get currentSampleName()  { return this.currentSelection.startsWith('sample:') ? this.currentSelection.slice(7) : ''; },
            get isUserTemplate()     { return this.currentSelection.startsWith('user:'); },
            get isMulti()            { return this.selection.length > 1; },

            bands: [],
            newBandKind: 'Detail',
            hoveredBand: null,     // { index, kind, ..., anchorTop (px viewport) }
            tools: [
                { kind: 'text',      label: 'Texto',      icon: 'T' },
                { kind: 'line',      label: 'Línea',      icon: '━' },
                { kind: 'rectangle', label: 'Rectángulo', icon: '▭' },
                { kind: 'table',     label: 'Tabla',      icon: '⊞' },
                { kind: 'image',     label: 'Imagen',     icon: '🖼' },
                { kind: 'barcode',   label: 'Código',     icon: '▦' },
                { kind: 'chart',     label: 'Gráfico',    icon: '📊' }
            ],

            // === Distribución: editor redimensionable / plegable ===
            editorWidth: 560,
            editorCollapsed: false,
            resizingEditor: null,
            EDITOR_STORAGE_KEY: 'netreporter.designer.editor',
            EDITOR_MIN: 280,
            showHelp: false,
            shortcuts: [
                ['Shift + arrastrar', 'Ajustar al paso de la cuadrícula'],
                ['Alt + arrastrar', 'Sin guías inteligentes'],
                ['R / G', 'Reglas / cuadrícula'],
                ['← ↑ → ↓', 'Mover 1 pt (Shift: 10 pt)'],
                ['Shift / ⌘ + clic', 'Agregar o quitar de la selección'],
                ['Arrastrar en vacío', 'Seleccionar por marco'],
                ['Ctrl/⌘ + A', 'Seleccionar todo'],
                ['Ctrl/⌘ + C / X / V', 'Copiar / cortar / pegar'],
                ['Ctrl/⌘ + D', 'Duplicar'],
                ['Supr / ⌫', 'Eliminar la selección'],
                ['Ctrl/⌘ + Z', 'Deshacer (Shift: rehacer)'],
                ['Ctrl/⌘ + S', 'Guardar plantilla'],
                ['Ctrl/⌘ + B', 'Mostrar / ocultar editor'],
                ['Ctrl/⌘ + + / − / 0', 'Zoom'],
                ['Esc', 'Quitar selección'],
                ['Ctrl/⌘ + rueda', 'Zoom en el punto del cursor'],
                ['RePág / AvPág', 'Página anterior / siguiente'],
                ['V', 'Vista limpia (sin marcos de edición)'],
                ['Doble clic', 'Ir al YAML del elemento'],
            ],
            BAND_LABELS: {
                ReportHeader: 'Encabezado de reporte', PageHeader: 'Encabezado de página', Detail: 'Detalle',
                PageFooter: 'Pie de página', ReportFooter: 'Pie de reporte'
            },
            bandLabel(kind) { return this.BAND_LABELS[kind] || kind || ''; },
            BAND_SHORT: { ReportHeader: 'Enc. rep.', PageHeader: 'Enc. pág.', Detail: 'Detalle', PageFooter: 'Pie pág.', ReportFooter: 'Pie rep.' },
            bandShortLabel(kind) { return this.BAND_SHORT[kind] || kind || ''; },

            defaultEditorWidth() { return Math.round(Math.max(this.EDITOR_MIN, Math.min(window.innerWidth * 0.4, 680))); },
            maxEditorWidth() { return Math.max(this.EDITOR_MIN, window.innerWidth - 520); },

            setEditorWidth(w) {
                this.editorWidth = Math.round(Math.min(this.maxEditorWidth(), Math.max(this.EDITOR_MIN, w)));
                this.persistEditorLayout();
            },

            persistEditorLayout() {
                try {
                    localStorage.setItem(this.EDITOR_STORAGE_KEY,
                        JSON.stringify({ width: this.editorWidth, collapsed: this.editorCollapsed }));
                } catch {}
            },

            toggleEditor() {
                this.editorCollapsed = !this.editorCollapsed;
                this.persistEditorLayout();
                this.$nextTick(() => this.onLayoutChanged());
            },

            startEditorResize(evt) {
                const section = evt.currentTarget.previousElementSibling;
                this.resizingEditor = { left: section.getBoundingClientRect().left };
                evt.currentTarget.setPointerCapture?.(evt.pointerId);
                document.body.style.cursor = 'col-resize';
                document.body.style.userSelect = 'none';
            },

            /** Reacciona a cambios de ancho del editor/preview. */
            onLayoutChanged() { this.refreshEditors(); this.$nextTick(() => this.drawRulers()); },

            // === Editor de código (CodeMirror) ===

            initEditors() {
                if (!window.CodeMirror) return;   // sin CDN: quedan los <textarea> planos
                const common = {
                    lineNumbers: true, styleActiveLine: true, indentUnit: 2, tabSize: 2, lineWrapping: false,
                    foldGutter: true, gutters: ['error-gutter', 'CodeMirror-linenumbers', 'CodeMirror-foldgutter'],
                    extraKeys: {
                        Tab: cm => cm.somethingSelected() ? cm.indentSelection('add') : cm.replaceSelection('  ', 'end'),
                        'Shift-Tab': cm => cm.indentSelection('subtract'),
                        'Alt-G': 'jumpToLine'
                    }
                };
                for (const [key, mode] of [['yaml', 'yaml'], ['json', { name: 'javascript', json: true }]]) {
                    const ta = document.getElementById(key + '-editor');
                    const cm = CodeMirror.fromTextArea(ta, {
                        ...common, mode, matchBrackets: key === 'json',
                        foldOptions: { rangeFinder: key === 'json' ? CodeMirror.fold.brace : CodeMirror.fold.indent }
                    });
                    cm.on('change', (_, change) => {
                        cm.save();
                        if (change.origin === 'setValue') return;
                        // Igual que si el usuario tecleara en el textarea: dispara el hx-trigger y el "dirty".
                        ta.dispatchEvent(new Event('input', { bubbles: true }));
                    });
                    EDITORS[key] = cm;
                }
                EDITORS.yaml.on('cursorActivity', () => {
                    if (EDITOR_STATE.programmatic) return;
                    clearTimeout(EDITOR_STATE.cursorTimer);
                    EDITOR_STATE.cursorTimer = setTimeout(() => this.highlightElementAtCursor(), 120);
                });
                EDITORS.yaml.on('blur', () => this.clearYamlCursorHighlight());
            },

            getEditorText(key) {
                const cm = EDITORS[key];
                return cm ? cm.getValue() : document.getElementById(key + '-editor').value;
            },

            /** Reemplaza el texto conservando scroll y cursor (las ediciones visuales reescriben el YAML entero). */
            setEditorText(key, text) {
                text = text ?? '';
                const ta = document.getElementById(key + '-editor');
                const cm = EDITORS[key];
                if (!cm) { ta.value = text; return; }
                if (cm.getValue() === text) return;
                const scroll = cm.getScrollInfo();
                const cursor = cm.getCursor();
                EDITOR_STATE.programmatic = true;
                try {
                    cm.setValue(text);
                    cm.setCursor(Math.min(cursor.line, cm.lastLine()), cursor.ch);
                    cm.scrollTo(scroll.left, scroll.top);
                } finally { EDITOR_STATE.programmatic = false; }
                ta.value = text;
            },

            showTab(key) {
                this.tab = key;
                this.$nextTick(() => EDITORS[key]?.refresh());
            },

            refreshEditors() {
                this.$nextTick(() => { EDITORS.yaml?.refresh(); EDITORS.json?.refresh(); });
            },

            /** Tras cada render del preview: mapa de líneas, marca de error y elemento enlazado. */
            syncPreviewDecorations() {
                try {
                    const node = document.querySelector('[data-yaml-lines]');
                    if (node) EDITOR_STATE.yamlLines = JSON.parse(node.textContent || '{}');
                } catch { EDITOR_STATE.yamlLines = {}; }

                // Error: limpiar la marca anterior y marcar la nueva (sin mover el cursor del usuario).
                const prev = EDITOR_STATE.error;
                if (prev) {
                    const cm = EDITORS[prev.source];
                    if (cm && prev.line - 1 <= cm.lastLine()) {
                        cm.removeLineClass(prev.line - 1, 'background', 'cm-error-line');
                    }
                    cm?.clearGutter('error-gutter');
                    EDITOR_STATE.error = null;
                }
                const box = document.querySelector('[data-preview-error]');
                const line = parseInt(box?.dataset.errorLine, 10);
                const source = box?.dataset.errorSource;
                if (box && Number.isFinite(line) && EDITORS[source]) {
                    const cm = EDITORS[source];
                    const l = Math.min(line - 1, cm.lastLine());
                    cm.addLineClass(l, 'background', 'cm-error-line');
                    const marker = document.createElement('span');
                    marker.className = 'cm-error-marker';
                    marker.textContent = '●';
                    marker.title = (box.querySelector('.font-mono')?.textContent || '').trim();
                    cm.setGutterMarker(l, 'error-gutter', marker);
                    EDITOR_STATE.error = { source, line: l + 1 };
                    box.querySelector('[data-goto-error]')?.addEventListener('click', () =>
                        this.gotoEditorLine(source, line, parseInt(box.dataset.errorColumn, 10) || 1));
                }
                if (!this.selected) this.revealInEditor(null);
            },

            gotoEditorLine(key, line, column = 1) {
                if (this.editorCollapsed) this.toggleEditor();
                this.showTab(key);
                this.$nextTick(() => {
                    const cm = EDITORS[key];
                    if (!cm) return;
                    const pos = { line: Math.max(0, line - 1), ch: Math.max(0, column - 1) };
                    cm.focus();
                    cm.setCursor(pos);
                    cm.scrollIntoView(pos, 80);
                });
            },

            /** Marca en el YAML las líneas del elemento seleccionado y las hace visibles (sin robar el foco). */
            revealInEditor(path) {
                const cm = EDITORS.yaml;
                if (!cm) return;
                const prev = EDITOR_STATE.linked;
                if (prev) {
                    cm.operation(() => {
                        for (let l = prev[0]; l <= prev[1] && l <= cm.lastLine(); l++) {
                            cm.removeLineClass(l, 'background', 'cm-linked-line');
                            cm.removeLineClass(l, 'gutter', 'cm-linked-gutter');
                        }
                    });
                    EDITOR_STATE.linked = null;
                }
                const range = path ? EDITOR_STATE.yamlLines[path] : null;
                if (!range) return;
                const from = range[0] - 1, to = Math.min(range[1] - 1, cm.lastLine());
                cm.operation(() => {
                    for (let l = from; l <= to; l++) {
                        cm.addLineClass(l, 'background', 'cm-linked-line');
                        cm.addLineClass(l, 'gutter', 'cm-linked-gutter');
                    }
                });
                EDITOR_STATE.linked = [from, to];
                if (!cm.hasFocus() && this.tab === 'yaml' && !this.editorCollapsed) {
                    const top = cm.charCoords({ line: from, ch: 0 }, 'local').top;
                    const bottom = cm.charCoords({ line: to, ch: 0 }, 'local').bottom;
                    const info = cm.getScrollInfo();
                    if (top < info.top || bottom > info.top + info.clientHeight)
                        cm.scrollTo(null, Math.max(0, top - info.clientHeight / 3));
                }
            },

            /** Elemento (o banda) cuyo bloque YAML contiene la línea del cursor → resaltado en el preview. */
            highlightElementAtCursor() {
                const cm = EDITORS.yaml;
                if (!cm) return;
                const line = cm.getCursor().line + 1;
                let best = null, bestSpan = Infinity;
                for (const [path, [a, b]] of Object.entries(EDITOR_STATE.yamlLines)) {
                    if (!path.includes('.elements.')) continue;
                    if (line >= a && line <= b && b - a < bestSpan) { best = path; bestSpan = b - a; }
                }
                this.clearYamlCursorHighlight();
                if (!best) return;
                const els = document.querySelectorAll(`.element-overlay[data-path="${best}"]`);
                els.forEach(e => e.classList.add('yaml-cursor'));
                const first = els[0];
                if (first) {
                    const host = document.getElementById('preview').getBoundingClientRect();
                    const r = first.getBoundingClientRect();
                    if (r.bottom < host.top || r.top > host.bottom || r.right < host.left || r.left > host.right)
                        first.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'smooth' });
                }
            },

            clearYamlCursorHighlight() {
                document.querySelectorAll('.element-overlay.yaml-cursor').forEach(e => e.classList.remove('yaml-cursor'));
            },

            async init() {
                try {
                    const layout = JSON.parse(localStorage.getItem(this.EDITOR_STORAGE_KEY) || 'null');
                    this.editorWidth = layout?.width ? layout.width : this.defaultEditorWidth();
                    this.editorCollapsed = !!layout?.collapsed;
                } catch { this.editorWidth = this.defaultEditorWidth(); }
                this.editorWidth = Math.min(this.maxEditorWidth(), Math.max(this.EDITOR_MIN, this.editorWidth));
                window.addEventListener('resize', () => {
                    if (this.editorWidth > this.maxEditorWidth()) this.editorWidth = this.maxEditorWidth();
                    this.drawRulers();
                });

                // Cargar zoom persistido antes de Promise.all para que el primer render salga ya escalado.
                const stored = parseFloat(localStorage.getItem(this.ZOOM_STORAGE_KEY));
                if (Number.isFinite(stored)) this.zoom = this.clampZoom(stored);

                this.loadGuides();
                this.initEditors();
                // Se crean con el contenedor aún oculto (x-cloak): medir otra vez cuando ya es visible.
                requestAnimationFrame(() => this.refreshEditors());
                await Promise.all([this.refreshTemplates(), this.refreshSamples()]);
                // Marcar dirty cuando el usuario edita los textareas manualmente.
                const mark = () => { this.isDirty = true; };
                document.getElementById('yaml-editor')?.addEventListener('input', mark);
                document.getElementById('json-editor')?.addEventListener('input', mark);

                // Sugerencias de bindings: se recalculan cuando cambia data.json.
                let jsonTimer = null;
                document.getElementById('json-editor')?.addEventListener('input', () => {
                    clearTimeout(jsonTimer);
                    jsonTimer = setTimeout(() => this.refreshJsonPaths(), 500);
                });
                this.refreshJsonPaths();

                try { this.clipboard = localStorage.getItem(this.CLIPBOARD_STORAGE_KEY) || null; } catch {}

                // Refrescar lista de bandas + reaplicar zoom cada vez que HTMX actualiza el preview.
                document.getElementById('preview')?.addEventListener('htmx:afterSwap', () => {
                    this.refreshBandsFromPreview();
                    this.applyZoomToDom();
                    this.syncPreviewDecorations();
                });
                // Doble clic en un elemento → su bloque en el YAML, con el cursor ahí.
                document.getElementById('preview')?.addEventListener('dblclick', evt => {
                    const el = evt.target.closest('.element-overlay');
                    const range = el && EDITOR_STATE.yamlLines[el.dataset.path];
                    if (range) this.gotoEditorLine('yaml', range[0]);
                });
            },

            // === Reglas, cuadrícula y guías ===

            showRulers: true,
            showGrid: false,
            gridStep: 5,
            smartGuides: true,
            rulerUnit: 'pt',
            rulerCursor: null,          // { x, y } en viewport-px mientras el mouse está sobre el preview
            GUIDES_STORAGE_KEY: 'netreporter.designer.guides',
            GUIDE_PX: 6,                // distancia de enganche, en px de pantalla
            get SNAP() { return this.gridStep || 5; },

            loadGuides() {
                try {
                    const g = JSON.parse(localStorage.getItem(this.GUIDES_STORAGE_KEY) || 'null');
                    if (g) {
                        this.showRulers = g.rulers ?? true;
                        this.showGrid = !!g.grid;
                        this.gridStep = +g.step || 5;
                        this.smartGuides = g.smart ?? true;
                        this.rulerUnit = ['pt', 'mm', 'cm', 'in'].includes(g.unit) ? g.unit : 'pt';
                    }
                } catch {}
            },

            persistGuides() {
                try {
                    localStorage.setItem(this.GUIDES_STORAGE_KEY, JSON.stringify({
                        rulers: this.showRulers, grid: this.showGrid, step: this.gridStep,
                        smart: this.smartGuides, unit: this.rulerUnit
                    }));
                } catch {}
            },

            toggleRulers() { this.showRulers = !this.showRulers; this.persistGuides(); this.$nextTick(() => this.drawRulers()); },
            toggleGrid() { this.showGrid = !this.showGrid; this.persistGuides(); this.applyGridToDom(); },
            cycleRulerUnit() {
                const units = ['pt', 'mm', 'cm', 'in'];
                this.rulerUnit = units[(units.indexOf(this.rulerUnit) + 1) % units.length];
                this.persistGuides();
                this.drawRulers();
            },

            pageMetrics() {
                const root = document.querySelector('[data-preview-root]');
                const n = k => parseFloat(root?.dataset[k]) || 0;
                return root ? {
                    ml: n('marginLeft'), mt: n('marginTop'), mr: n('marginRight'), mb: n('marginBottom'),
                    w: n('pageWidth'), h: n('pageHeight')
                } : null;
            },

            applyGridToDom() {
                const host = document.getElementById('preview');
                if (!host) return;
                host.classList.toggle('show-grid', this.showGrid);
                const m = this.pageMetrics();
                host.style.setProperty('--grid-step', this.gridStep + 'px');
                host.style.setProperty('--grid-ox', (m?.ml ?? 0) + 'px');
                host.style.setProperty('--grid-oy', (m?.mt ?? 0) + 'px');
            },

            onPreviewHover(evt) {
                if (!this.showRulers) return;
                this.rulerCursor = { x: evt.clientX, y: evt.clientY };
                if (!this._rulerRaf) this._rulerRaf = requestAnimationFrame(() => { this._rulerRaf = null; this.drawRulers(); });
            },

            /** Pinta ambas reglas para la página en vista: 0 = origen del contenido; margen sombreado; selección y cursor marcados. */
            drawRulers() {
                if (!this.showRulers) return;
                const cx = document.getElementById('ruler-x'), cy = document.getElementById('ruler-y');
                const host = document.getElementById('preview');
                const page = this.pageEls()[this.currentPage - 1];
                const m = this.pageMetrics();
                if (!cx || !cy || !host) return;
                const unitPt = { pt: 1, mm: 72 / 25.4, cm: 72 / 2.54, in: 72 }[this.rulerUnit];
                const dpr = window.devicePixelRatio || 1;
                const z = this.zoom;
                const pr = page?.getBoundingClientRect();

                // Rango de la selección (coords de página) para sombrearlo en las reglas.
                let sel = null;
                for (const it of this.selection) {
                    const el = this.overlayFor(it.path);
                    if (!el || el.closest('.svg-page') !== page) continue;
                    const b = { x: +el.dataset.x, y: +el.dataset.y, r: +el.dataset.x + +el.dataset.w, bt: +el.dataset.y + +el.dataset.h };
                    sel = sel ? { x: Math.min(sel.x, b.x), y: Math.min(sel.y, b.y), r: Math.max(sel.r, b.r), bt: Math.max(sel.bt, b.bt) } : b;
                }

                const draw = (canvas, horizontal) => {
                    const rect = canvas.getBoundingClientRect();
                    const len = horizontal ? rect.width : rect.height;
                    const thick = horizontal ? rect.height : rect.width;
                    if (len <= 0) return;
                    canvas.width = Math.round(rect.width * dpr);
                    canvas.height = Math.round(rect.height * dpr);
                    const g = canvas.getContext('2d');
                    g.setTransform(dpr, 0, 0, dpr, 0, 0);
                    g.clearRect(0, 0, rect.width, rect.height);
                    g.fillStyle = '#f1f5f9';
                    g.fillRect(0, 0, rect.width, rect.height);
                    if (!pr || !m) return;

                    // Posición en la regla (px) de una coordenada de página (pt).
                    const start = horizontal ? pr.left - rect.left : pr.top - rect.top;
                    const toPx = pt => start + pt * z;
                    const pageLen = horizontal ? m.w : m.h;
                    const m0 = horizontal ? m.ml : m.mt, m1 = horizontal ? m.mr : m.mb;
                    const fill = (a, b, color) => {
                        g.fillStyle = color;
                        const p0 = toPx(a), p1 = toPx(b);
                        if (horizontal) g.fillRect(p0, 0, p1 - p0, thick); else g.fillRect(0, p0, thick, p1 - p0);
                    };
                    fill(0, pageLen, '#ffffff');
                    fill(0, m0, '#e2e8f0');
                    fill(pageLen - m1, pageLen, '#e2e8f0');
                    if (sel) fill(horizontal ? sel.x : sel.y, horizontal ? sel.r : sel.bt, 'rgba(245, 158, 11, 0.35)');

                    // Paso mayor: el primero que deje ≥ 48px entre números.
                    const steps = [1, 2, 5, 10, 20, 25, 50, 100, 200, 500, 1000];
                    const major = steps.find(st => st * unitPt * z >= 48) ?? 1000;
                    const minor = major / (major % 5 === 0 ? 5 : 2);
                    const origin = toPx(m0);
                    const from = Math.floor((-origin) / (minor * unitPt * z)) - 1;
                    const to = Math.ceil((len - origin) / (minor * unitPt * z)) + 1;
                    g.strokeStyle = '#94a3b8';
                    g.fillStyle = '#475569';
                    g.font = '9px ui-monospace, Menlo, monospace';
                    g.lineWidth = 1;
                    g.beginPath();
                    for (let i = from; i <= to; i++) {
                        const v = i * minor;                         // en unidades, relativo al origen del contenido
                        const p = Math.round(origin + v * unitPt * z) + 0.5;
                        if (p < 0 || p > len) continue;
                        const isMajor = Math.abs(v / major - Math.round(v / major)) < 1e-6;
                        const tick = isMajor ? thick * 0.55 : thick * 0.25;
                        if (horizontal) { g.moveTo(p, thick); g.lineTo(p, thick - tick); }
                        else { g.moveTo(thick, p); g.lineTo(thick - tick, p); }
                        if (isMajor) {
                            const label = String(+v.toFixed(2));
                            if (horizontal) g.fillText(label, p + 2, 9);
                            else { g.save(); g.translate(9, p + 2); g.rotate(Math.PI / 2); g.fillText(label, 0, 0); g.restore(); }
                        }
                    }
                    g.stroke();

                    if (this.rulerCursor) {
                        const c = horizontal ? this.rulerCursor.x - rect.left : this.rulerCursor.y - rect.top;
                        g.strokeStyle = 'rgb(236, 72, 153)';
                        g.beginPath();
                        if (horizontal) { g.moveTo(c + 0.5, 0); g.lineTo(c + 0.5, thick); }
                        else { g.moveTo(0, c + 0.5); g.lineTo(thick, c + 0.5); }
                        g.stroke();
                    }
                };
                draw(cx, true);
                draw(cy, false);
            },

            // --- Guías inteligentes ---

            /** Al empezar a arrastrar: bordes y centros de los demás elementos de la página, márgenes y centro. */
            collectGuideTargets(pageEl, movingPaths) {
                const m = this.pageMetrics();
                const xs = [], ys = [];
                if (m) {
                    xs.push(m.ml, m.w - m.mr, (m.ml + m.w - m.mr) / 2);
                    ys.push(m.mt, m.h - m.mb, (m.mt + m.h - m.mb) / 2);
                }
                for (const el of pageEl.querySelectorAll('.element-overlay')) {
                    if (movingPaths.has(el.dataset.path)) continue;
                    const x = +el.dataset.x, y = +el.dataset.y, w = +el.dataset.w, h = +el.dataset.h;
                    xs.push(x, x + w / 2, x + w);
                    ys.push(y, y + h / 2, y + h);
                }
                return { xs, ys };
            },

            /** Ajusta (dx, dy) para que un borde o centro del grupo coincida con una guía; dibuja las guías activas. */
            snapToGuides(drag, dx, dy) {
                const g = drag.guides;
                const b = drag.box;   // bbox del grupo al empezar (coords de página)
                const tol = this.GUIDE_PX / this.zoom;
                const best = (edges, targets) => {
                    let hit = null;
                    for (const e of edges) for (const t of targets) {
                        const d = t - e;
                        if (Math.abs(d) <= tol && (!hit || Math.abs(d) < Math.abs(hit.d))) hit = { d, at: t };
                    }
                    return hit;
                };
                const nx = b.x + dx, ny = b.y + dy;
                const hx = best([nx, nx + b.w / 2, nx + b.w], g.xs);
                const hy = best([ny, ny + b.h / 2, ny + b.h], g.ys);
                if (hx) dx += hx.d;
                if (hy) dy += hy.d;
                this.renderGuides(drag.pageEl, hx?.at, hy?.at);
                return [dx, dy];
            },

            renderGuides(pageEl, x, y) {
                document.querySelectorAll('.smart-guide').forEach(e => e.remove());
                if (!pageEl) return;
                const add = (cls, prop, v) => {
                    const d = document.createElement('div');
                    d.className = 'smart-guide ' + cls;
                    d.style[prop] = v + 'px';
                    pageEl.appendChild(d);
                };
                if (x != null) add('v', 'left', x);
                if (y != null) add('h', 'top', y);
            },

            // === Navegación del preview ===

            pageCount: 0,
            currentPage: 1,
            cleanView: false,
            _scrollTick: false,

            pageEls() { return Array.from(document.querySelectorAll('#preview .svg-page')); },

            updatePageInfo() {
                this.applyGridToDom();
                this.pageCount = this.pageEls().length;
                if (this.currentPage > this.pageCount) this.currentPage = Math.max(1, this.pageCount);
                this.trackCurrentPage();
            },

            onPreviewScroll() {
                if (this._scrollTick) return;
                this._scrollTick = true;
                requestAnimationFrame(() => { this._scrollTick = false; this.trackCurrentPage(); });
            },

            trackCurrentPage() {
                const host = document.getElementById('preview');
                const pages = this.pageEls();
                this.drawRulers();
                if (!host || !pages.length) return;
                const probe = host.getBoundingClientRect().top + host.clientHeight * 0.35;
                let current = 1;
                pages.forEach((p, i) => { if (p.getBoundingClientRect().top <= probe) current = i + 1; });
                if (current !== this.currentPage) { this.currentPage = current; this.drawRulers(); }
            },

            goToPage(n) {
                const pages = this.pageEls();
                if (!pages.length || !Number.isFinite(n)) return;
                n = Math.min(pages.length, Math.max(1, n));
                const host = document.getElementById('preview');
                const top = pages[n - 1].getBoundingClientRect().top - host.getBoundingClientRect().top + host.scrollTop;
                host.scrollTo({ top: Math.max(0, top - 16) });
                this.currentPage = n;
            },

            toggleCleanView() {
                this.cleanView = !this.cleanView;
                if (this.cleanView) this.clearSelection();
            },

            /** Ctrl/⌘ + rueda (o pinch del trackpad): zoom anclado al punto bajo el cursor. */
            onPreviewWheel(evt) {
                if (!(evt.ctrlKey || evt.metaKey)) return;
                evt.preventDefault();
                const host = document.getElementById('preview');
                const r = host.getBoundingClientRect();
                const ax = evt.clientX - r.left, ay = evt.clientY - r.top;
                const rx = (host.scrollLeft + ax) / host.scrollWidth;
                const ry = (host.scrollTop + ay) / host.scrollHeight;
                const next = Math.abs(evt.deltaY) < 40
                    ? this.zoom * Math.exp(-evt.deltaY * 0.01)          // trackpad: continuo
                    : this.nextZoomLevel(evt.deltaY < 0 ? +1 : -1);      // rueda: por pasos
                this.setZoom(next);
                host.scrollLeft = rx * host.scrollWidth - ax;
                host.scrollTop = ry * host.scrollHeight - ay;
            },

            zoomFitPage() {
                const host = document.getElementById('preview');
                const page = host?.querySelector('.svg-page');
                if (!host || !page) return;
                const w = parseFloat(page.style.width), h = parseFloat(page.style.height);
                if (!(w > 0 && h > 0)) return;
                // p-6 = 24px por lado; la etiqueta "Página n de N" bajo la hoja ocupa ~28px.
                this.setZoom(Math.min((host.clientWidth - 48) / w, (host.clientHeight - 48 - 28) / h));
                this.goToPage(this.currentPage);
            },

            // === Zoom ===

            clampZoom(z) { return Math.min(this.ZOOM_MAX, Math.max(this.ZOOM_MIN, z)); },

            nextZoomLevel(dir) {
                // Buscar el step del array más cercano en la dirección pedida.
                const cur = this.zoom;
                if (dir > 0) {
                    return this.ZOOM_LEVELS.find(z => z > cur + 1e-6) ?? this.ZOOM_MAX;
                } else {
                    const lower = this.ZOOM_LEVELS.filter(z => z < cur - 1e-6);
                    return lower.length ? lower[lower.length - 1] : this.ZOOM_MIN;
                }
            },

            setZoom(z) {
                this.zoom = this.clampZoom(z);
                try { localStorage.setItem(this.ZOOM_STORAGE_KEY, String(this.zoom)); } catch {}
                this.applyZoomToDom();
                this.$nextTick(() => this.drawRulers());
            },

            zoomIn()    { this.setZoom(this.nextZoomLevel(+1)); },
            zoomOut()   { this.setZoom(this.nextZoomLevel(-1)); },
            zoomReset() { this.setZoom(1); },

            zoomFitWidth() {
                const host = document.getElementById('preview');
                const page = host?.querySelector('.svg-page');
                if (!host || !page) return;
                const pageWidth = parseFloat(page.style.width);
                if (!Number.isFinite(pageWidth) || pageWidth <= 0) return;
                // p-6 = 1.5rem * 2 = 48px de padding horizontal del contenedor scrollable.
                const padding = 48;
                const target = (host.clientWidth - padding) / pageWidth;
                this.setZoom(target);
            },

            applyZoomToDom() {
                // Tanto el host (que aplica transform:scale) como el spacer
                // (que reserva el espacio post-escalado para el scroll) leen --zoom.
                const root = document.querySelector('[data-preview-root]');
                const spacer = document.querySelector('[data-zoom-spacer]');
                if (root) root.style.setProperty('--zoom', this.zoom);
                if (spacer) {
                    spacer.style.setProperty('--zoom', this.zoom);
                    // Para reservar el alto post-escalado tomamos la altura natural del host
                    // (suma de páginas + gaps) ANTES de que el transform la afecte. Como
                    // transform no toca el bounding box del child, offsetHeight del host
                    // sigue siendo el alto sin escalar — multiplicamos por zoom.
                    if (root) {
                        spacer.style.height = (root.offsetHeight * this.zoom) + 'px';
                    }
                }
            },

            async refreshSamples() {
                try {
                    const res = await fetch('/Home/ListSamples');
                    const data = await res.json();
                    this.availableSamples = Array.isArray(data) ? data : [];
                } catch { this.availableSamples = []; }
            },

            refreshBandsFromPreview() {
                const zones = document.querySelectorAll('.band-dropzone');
                const seen = new Set();
                const out = [];
                for (const z of zones) {
                    const idx = parseInt(z.dataset.bandIndex, 10);
                    if (!Number.isFinite(idx) || seen.has(idx)) continue;
                    seen.add(idx);
                    out.push({
                        index: idx,
                        kind: z.dataset.bandKind || 'Detail',
                        y: parseFloat(z.dataset.bandY) || 0,
                        height: parseFloat(z.dataset.bandHeight) || 0,
                        declaredHeight: parseFloat(z.dataset.bandDeclaredHeight) || 0,
                        elementCount: parseInt(z.dataset.bandElementCount, 10) || 0
                    });
                }
                out.sort((a, b) => a.index - b.index);
                this.bands = out;
                this.$nextTick(() => this.updatePageInfo());
            },

            get busyLabel() {
                if (this.moving) return 'Moviendo…';
                if (this.resizing) return 'Redimensionando…';
                if (this.creating) return 'Creando…';
                if (this.saving) return 'Guardando…';
                return 'Renderizando…';
            },

            onToolPointerDown(evt, kind) {
                evt.preventDefault();
                if (this.cleanView) this.cleanView = false;   // crear necesita las zonas de las bandas
                this.clearSelection();
                this.creating = { kind, x: evt.clientX, y: evt.clientY };
            },

            // === Undo / Redo ===

            pushUndo() {
                const yaml = this.getEditorText('yaml');
                const last = this.undoStack[this.undoStack.length - 1];
                if (last === yaml) return;           // no-op
                this.undoStack.push(yaml);
                if (this.undoStack.length > this.MAX_HISTORY) this.undoStack.shift();
                this.redoStack = [];                 // acción nueva rompe cadena de redo
            },

            async undo() {
                if (this.undoStack.length === 0) return;
                const current = this.getEditorText('yaml');
                const previous = this.undoStack.pop();
                this.redoStack.push(current);
                if (this.redoStack.length > this.MAX_HISTORY) this.redoStack.shift();
                await this.restoreSnapshot(previous);
            },

            async redo() {
                if (this.redoStack.length === 0) return;
                const current = this.getEditorText('yaml');
                const next = this.redoStack.pop();
                this.undoStack.push(current);
                if (this.undoStack.length > this.MAX_HISTORY) this.undoStack.shift();
                await this.restoreSnapshot(next);
            },

            async restoreSnapshot(yaml) {
                this.setEditorText('yaml', yaml);
                const form = new FormData();
                form.append('Yaml', yaml);
                form.append('Json', this.getEditorText('json'));
                const res = await fetch('/Home/Preview', { method: 'POST', body: form });
                const html = await res.text();
                this.setPreviewHtml(html);
                this.clearSelection();
                this.refreshBandsFromPreview();
                this.applyZoomToDom();
            },

            onKeyDown(evt) {
                const isModKey = evt.metaKey || evt.ctrlKey;
                if (isModKey && !evt.altKey && evt.key.toLowerCase() === 's') {
                    evt.preventDefault();
                    this.saveTemplate();
                    return;
                }
                if (isModKey && !evt.altKey && evt.key.toLowerCase() === 'b') {
                    evt.preventDefault();
                    this.toggleEditor();
                    return;
                }
                if (evt.key === '?' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(evt.target.tagName) && !evt.target.isContentEditable) {
                    this.showHelp = !this.showHelp;
                    return;
                }
                // Ignorar si foco está en un input de texto del drawer o los textareas.
                const tag = evt.target.tagName;
                const inEditor = evt.target.id === 'yaml-editor' || evt.target.id === 'json-editor';
                if (inEditor) return;                                        // textarea tiene su propio undo nativo
                if (tag === 'INPUT' || tag === 'TEXTAREA') return;

                const isMod = evt.metaKey || evt.ctrlKey;

                // Ctrl/Cmd + Z / Shift+Z / Y → undo/redo
                if (isMod) {
                    const key = evt.key.toLowerCase();
                    if (key === 'z') {
                        evt.preventDefault();
                        if (evt.shiftKey) this.redo();
                        else this.undo();
                        return;
                    }
                    if (key === 'y') {
                        evt.preventDefault();
                        this.redo();
                        return;
                    }
                    if (key === 'd' && this.selection.length) {
                        evt.preventDefault();
                        this.duplicateSelection();
                        return;
                    }
                    if (key === 'c' && this.selection.length) {
                        evt.preventDefault();
                        this.copySelection();
                        return;
                    }
                    if (key === 'x' && this.selection.length) {
                        evt.preventDefault();
                        this.cutSelection();
                        return;
                    }
                    if (key === 'v') {
                        evt.preventDefault();
                        this.pasteClipboard();
                        return;
                    }
                    if (key === 'a') {
                        evt.preventDefault();
                        this.selectAll();
                        return;
                    }
                    // Zoom: Ctrl/Cmd + (= o +) → in, + (- o _) → out, + 0 → reset.
                    if (key === '=' || key === '+') {
                        evt.preventDefault();
                        this.zoomIn();
                        return;
                    }
                    if (key === '-' || key === '_') {
                        evt.preventDefault();
                        this.zoomOut();
                        return;
                    }
                    if (key === '0') {
                        evt.preventDefault();
                        this.zoomReset();
                        return;
                    }
                    return;
                }

                if (evt.key === 'Escape') { this.showHelp = false; this.clearSelection(); return; }
                if (evt.key === 'PageDown' || evt.key === 'PageUp') {
                    evt.preventDefault();
                    this.goToPage(this.currentPage + (evt.key === 'PageDown' ? 1 : -1));
                    return;
                }
                if ((evt.key === 'v' || evt.key === 'V') && !evt.shiftKey && !evt.altKey) {
                    this.toggleCleanView();
                    return;
                }
                if ((evt.key === 'r' || evt.key === 'R') && !evt.shiftKey && !evt.altKey) { this.toggleRulers(); return; }
                if ((evt.key === 'g' || evt.key === 'G') && !evt.shiftKey && !evt.altKey) { this.toggleGrid(); return; }

                // Delete / Backspace → borrar la selección (uno o varios).
                if (this.selection.length && (evt.key === 'Delete' || evt.key === 'Backspace')) {
                    evt.preventDefault();
                    this.deleteSelection();
                    return;
                }

                // Arrow keys → nudge de toda la selección (sin modifier salvo Shift).
                if (!this.selection.length) return;
                const arrows = {
                    ArrowLeft:  [-1,  0],
                    ArrowRight: [ 1,  0],
                    ArrowUp:    [ 0, -1],
                    ArrowDown:  [ 0,  1]
                };
                const dir = arrows[evt.key];
                if (!dir) return;
                evt.preventDefault();
                const step = evt.shiftKey ? 10 : 1;
                this.nudgeSelected(dir[0] * step, dir[1] * step);
            },

            // === Columnas de tabla ===

            addColumn() {
                this.form.columns.push({
                    header: 'Nueva columna',
                    binding: '$.campo',
                    width: 80,
                    format: '',
                    align: 'left',
                    expanded: true    // la nueva arranca expandida para editarla rápido
                });
                this.flushColumns();
            },

            removeColumn(idx) {
                this.form.columns.splice(idx, 1);
                this.flushColumns();
            },

            moveColumn(idx, delta) {
                const newIdx = idx + delta;
                if (newIdx < 0 || newIdx >= this.form.columns.length) return;
                const [col] = this.form.columns.splice(idx, 1);
                this.form.columns.splice(newIdx, 0, col);
                this.flushColumns();
            },

            async flushColumns() {
                if (!this.selected || this.selected.kind !== 'table') return;
                const path = this.selected.path;
                this.pushUndo();
                this.saving = true;
                try {
                    // Enviar solo los campos que entiende el backend (omitir 'expanded' que es UI-only).
                    const payload = this.form.columns.map(c => ({
                        header: c.header,
                        binding: c.binding,
                        width: c.width,
                        format: c.format,
                        align: c.align
                    }));
                    const form = this.buildFormData();
                    form.append('Path', path);
                    form.append('ColumnsJson', JSON.stringify(payload));
                    const res = await fetch('/Home/UpdateColumns', { method: 'POST', body: form });
                    const data = await res.json();
                    if (data.error) {
                        console.error('UpdateColumns:', data.error);
                        return;
                    }
                    // Actualiza YAML + preview pero PRESERVA el form.columns actual del usuario
                    // para no robarle el foco durante edición.
                    this.setEditorText('yaml', data.yaml);
                    this.setPreviewHtml(data.previewHtml);
                    this.isDirty = true;
                    this.refreshBandsFromPreview();
                    this.applyZoomToDom();
                    this.reselectByPath(path, /* preserveFormState */ true);
                } finally { this.saving = false; }
            },

            // === Band management ===

            async addBand() {
                this.pushUndo();
                this.saving = true;
                try {
                    const form = this.buildFormData();
                    form.append('Kind', this.newBandKind);
                    form.append('Height', '40');
                    const res = await fetch('/Home/AddBand', { method: 'POST', body: form });
                    const data = await res.json();
                    if (data.error) { alert('Error: ' + data.error); return; }
                    this.applyServerResponse(data);
                } finally { this.saving = false; }
            },

            async deleteBand(bandIndex) {
                if (!confirm(`¿Borrar banda ${bandIndex}? Se eliminarán todos sus elementos.`)) return;
                this.pushUndo();
                this.saving = true;
                try {
                    const form = this.buildFormData();
                    form.append('BandIndex', bandIndex.toString());
                    const res = await fetch('/Home/DeleteBand', { method: 'POST', body: form });
                    const data = await res.json();
                    if (data.error) { alert('Error: ' + data.error); return; }
                    this.applyServerResponse(data);
                } finally { this.saving = false; }
            },

            async moveBandUp(bandIndex)   { if (bandIndex > 0) await this._moveBand(bandIndex, bandIndex - 1); },
            async moveBandDown(bandIndex) { await this._moveBand(bandIndex, bandIndex + 1); },

            showBandTooltip(band, evt) {
                const rect = evt.currentTarget.getBoundingClientRect();
                this.hoveredBand = {
                    ...band,
                    anchorLeft: rect.right + 8,      // 8px a la derecha de la fila
                    anchorTop: rect.top
                };
            },

            async _moveBand(from, to) {
                this.pushUndo();
                this.saving = true;
                try {
                    const form = this.buildFormData();
                    form.append('FromIndex', from.toString());
                    form.append('ToIndex', to.toString());
                    const res = await fetch('/Home/MoveBand', { method: 'POST', body: form });
                    const data = await res.json();
                    if (data.error) { alert('Error: ' + data.error); return; }
                    this.applyServerResponse(data);
                } finally { this.saving = false; }
            },

            selectionPaths() { return this.selection.map(s => s.path); },

            async duplicateSelection() {
                if (!this.selection.length) return;
                // Duplicar = copiar + pegar en las mismas bandas con offset (+10, +10). No toca el portapapeles.
                const clip = await this.requestCopy(this.selectionPaths());
                if (clip) await this.pasteYaml(clip, null, 10, 10);
            },

            async deleteSelection() {
                if (!this.selection.length) return;
                this.pushUndo();
                this.saving = true;
                try {
                    const form = this.buildFormData();
                    form.append('PathsJson', JSON.stringify(this.selectionPaths()));
                    const res = await fetch('/Home/DeleteMany', { method: 'POST', body: form });
                    const data = await res.json();
                    if (data.error) {
                        alert('Error al borrar: ' + data.error);
                    } else {
                        this.applyServerResponse(data);
                    }
                } finally { this.saving = false; }
            },

            // === Clipboard ===

            async requestCopy(paths) {
                const form = this.buildFormData();
                form.append('PathsJson', JSON.stringify(paths));
                const res = await fetch('/Home/Copy', { method: 'POST', body: form });
                const data = await res.json();
                if (data.error) { alert('Error al copiar: ' + data.error); return null; }
                return data.clipboard;
            },

            async copySelection() {
                const clip = await this.requestCopy(this.selectionPaths());
                if (!clip) return false;
                this.clipboard = clip;
                this.clipboardFromCut = false;
                try { localStorage.setItem(this.CLIPBOARD_STORAGE_KEY, clip); } catch {}
                // Best effort: también al portapapeles del sistema (útil para pegar en otro navegador/pestaña).
                try { await navigator.clipboard?.writeText(clip); } catch {}
                return true;
            },

            async cutSelection() {
                if (await this.copySelection()) {
                    this.clipboardFromCut = true;
                    await this.deleteSelection();
                }
            },

            async pasteClipboard() {
                let clip = this.clipboard;
                if (!clip) {
                    try {
                        const text = await navigator.clipboard?.readText();
                        if (text && text.includes('netReporterClipboard')) clip = text;
                    } catch {}
                }
                if (!clip) return;
                // Destino: la banda del elemento primario seleccionado; sin selección, las bandas originales.
                const target = this.selected ? parseInt(this.selected.path.split('.')[1], 10) : null;
                const offset = this.clipboardFromCut ? 0 : 10;
                this.clipboardFromCut = false;
                await this.pasteYaml(clip, Number.isFinite(target) ? target : null, offset, offset);
            },

            async pasteYaml(clip, bandIndex, dx, dy) {
                this.pushUndo();
                this.saving = true;
                try {
                    const form = this.buildFormData();
                    form.append('Clipboard', clip);
                    if (bandIndex !== null && bandIndex !== undefined) form.append('BandIndex', String(bandIndex));
                    form.append('OffsetX', String(dx));
                    form.append('OffsetY', String(dy));
                    const res = await fetch('/Home/Paste', { method: 'POST', body: form });
                    const data = await res.json();
                    if (data.error) { alert('Error al pegar: ' + data.error); return; }
                    this.applyServerResponse(data);
                    this.reselectByPaths(data.newPaths || []);
                } finally { this.saving = false; }
            },

            selectAll() {
                const seen = new Set();
                const items = [];
                for (const el of document.querySelectorAll('.element-overlay')) {
                    if (seen.has(el.dataset.path)) continue;
                    seen.add(el.dataset.path);
                    items.push(el);
                }
                this.setSelection(items);
            },

            // === Alinear (multi) ===

            async alignSelection(mode) {
                if (this.selection.length < 2) return;
                const boxes = this.selection.map(s => {
                    const el = this.overlayFor(s.path);
                    return {
                        path: s.path,
                        x: parseFloat(el?.dataset.x) || 0, y: parseFloat(el?.dataset.y) || 0,
                        w: parseFloat(el?.dataset.w) || 0, h: parseFloat(el?.dataset.h) || 0
                    };
                });
                const minX = Math.min(...boxes.map(b => b.x));
                const maxR = Math.max(...boxes.map(b => b.x + b.w));
                const minY = Math.min(...boxes.map(b => b.y));
                const maxB = Math.max(...boxes.map(b => b.y + b.h));
                const cx = (minX + maxR) / 2, cy = (minY + maxB) / 2;
                const moves = boxes.map(b => {
                    let dx = 0, dy = 0;
                    if (mode === 'left')    dx = minX - b.x;
                    if (mode === 'right')   dx = maxR - (b.x + b.w);
                    if (mode === 'hcenter') dx = cx - (b.x + b.w / 2);
                    if (mode === 'top')     dy = minY - b.y;
                    if (mode === 'bottom')  dy = maxB - (b.y + b.h);
                    if (mode === 'vmiddle') dy = cy - (b.y + b.h / 2);
                    return { path: b.path, dx: +dx.toFixed(2), dy: +dy.toFixed(2) };
                }).filter(m => Math.abs(m.dx) > 0.01 || Math.abs(m.dy) > 0.01);
                if (moves.length) await this.sendMoves(moves);
            },

            async sendMoves(moves) {
                const paths = this.selectionPaths();
                const primary = this.selected?.path;
                this.pushUndo();
                this.moving = true;
                try {
                    const form = this.buildFormData();
                    form.append('MovesJson', JSON.stringify(moves));
                    const res = await fetch('/Home/MoveMany', { method: 'POST', body: form });
                    const data = await res.json();
                    if (data.error) { console.error('MoveMany:', data.error); return false; }
                    this.applyServerResponse(data);
                    this.reselectByPaths(paths, primary);
                    return true;
                } finally { this.moving = false; }
            },

            // === Imagen / chart ===

            onImageFileChosen(evt) {
                const file = evt.target.files?.[0];
                evt.target.value = '';
                if (!file) return;
                if (file.size > 2 * 1024 * 1024 &&
                    !confirm('La imagen pesa más de 2 MB y quedará embebida en el YAML. ¿Continuar?')) return;
                const reader = new FileReader();
                reader.onload = () => this.applyPatch({ Source: reader.result });
                reader.readAsDataURL(file);
            },

            addSeries() {
                const palette = ['#2563EB', '#F59E0B', '#10B981', '#EF4444', '#8B5CF6', '#06B6D4'];
                this.form.series.push({
                    name: 'Serie ' + (this.form.series.length + 1),
                    value: this.rowPaths.find(p => p !== this.form.category) || '$.valor',
                    color: palette[this.form.series.length % palette.length]
                });
                this.flushSeries();
            },

            removeSeries(idx) {
                if (this.form.series.length <= 1) return;
                this.form.series.splice(idx, 1);
                this.flushSeries();
            },

            async flushSeries() {
                if (!this.selected || this.selected.kind !== 'chart') return;
                const path = this.selected.path;
                this.pushUndo();
                this.saving = true;
                try {
                    const form = this.buildFormData();
                    form.append('Path', path);
                    form.append('SeriesJson', JSON.stringify(this.form.series.map(se => ({
                        name: se.name, value: se.value, color: se.color
                    }))));
                    const res = await fetch('/Home/UpdateSeries', { method: 'POST', body: form });
                    const data = await res.json();
                    if (data.error) { console.error('UpdateSeries:', data.error); return; }
                    this.setEditorText('yaml', data.yaml);
                    this.setPreviewHtml(data.previewHtml);
                    this.isDirty = true;
                    this.refreshBandsFromPreview();
                    this.applyZoomToDom();
                    this.reselectByPath(path, /* preserveFormState */ true);
                } finally { this.saving = false; }
            },

            // === Sugerencias de bindings desde data.json ===

            refreshJsonPaths() {
                let data;
                try { data = JSON.parse(this.getEditorText('json') || '{}'); }
                catch { return; }
                const scalars = [], arrays = [];
                const walk = (node, path, depth) => {
                    if (depth > 6) return;
                    if (Array.isArray(node)) {
                        arrays.push(path);
                        return;
                    }
                    if (node && typeof node === 'object') {
                        for (const [k, v] of Object.entries(node)) walk(v, path + '.' + k, depth + 1);
                        return;
                    }
                    if (path !== '$') scalars.push(path);
                };
                walk(data, '$', 0);
                this.jsonPaths = scalars.slice(0, 300);
                this.arrayPaths = arrays.slice(0, 100);
                this._jsonData = data;
            },

            refreshRowPaths(rowsPath) {
                // Campos de la primera fila del array apuntado → sugerencias para columnas/categoría/series.
                const data = this._jsonData;
                if (!data || !rowsPath) { this.rowPaths = []; return; }
                let node = data;
                for (const seg of rowsPath.replace(/^\$\.?/, '').replace(/\[\*\]$/, '').split('.').filter(Boolean)) {
                    node = node?.[seg];
                }
                const first = Array.isArray(node) ? node.find(x => x && typeof x === 'object') : null;
                const out = [];
                const walk = (n, path, depth) => {
                    if (depth > 3 || n === null || n === undefined) return;
                    if (typeof n === 'object' && !Array.isArray(n)) {
                        for (const [k, v] of Object.entries(n)) walk(v, path + '.' + k, depth + 1);
                    } else if (!Array.isArray(n)) out.push(path);
                };
                if (first) walk(first, '$', 0);
                this.rowPaths = out;
            },

            exportPdf() { this.exportTo('/Home/ExportPdf'); },
            exportHtml() { this.exportTo('/Home/ExportHtml'); },
            exportXlsx() { this.exportTo('/Home/ExportXlsx'); },

            exportTo(action) {
                // Form POST con target _blank → el browser abre/descarga la respuesta.
                // OJO: usar <textarea> (no <input>) para preservar newlines del YAML;
                // <input type="text"> los normaliza a espacios y rompe el parse.
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = action;
                form.target = '_blank';
                form.style.display = 'none';

                const yaml = document.createElement('textarea');
                yaml.name = 'Yaml'; yaml.value = this.getEditorText('yaml');
                form.appendChild(yaml);

                const json = document.createElement('textarea');
                json.name = 'Json'; json.value = this.getEditorText('json');
                form.appendChild(json);

                document.body.appendChild(form);
                form.submit();
                document.body.removeChild(form);
            },

            nudgeSelected(dx, dy) {
                if (!this.selection.length) return;

                // Feedback visual inmediato: mover los overlays de toda la selección.
                for (const s of this.selection) {
                    document.querySelectorAll(`.element-overlay[data-path="${s.path}"]`).forEach(el => {
                        el.style.left = ((parseFloat(el.style.left) || 0) + dx) + 'px';
                        el.style.top  = ((parseFloat(el.style.top)  || 0) + dy) + 'px';
                    });
                }

                // Acumula para flush debounced.
                if (!this.pendingNudge) {
                    this.pendingNudge = { dx: 0, dy: 0, paths: this.selectionPaths() };
                }
                this.pendingNudge.dx += dx;
                this.pendingNudge.dy += dy;

                clearTimeout(this.nudgeTimeout);
                this.nudgeTimeout = setTimeout(() => this.flushNudge(), 300);
            },

            async flushNudge() {
                const n = this.pendingNudge;
                if (!n) return;
                this.pendingNudge = null;
                if (n.dx === 0 && n.dy === 0) return;
                await this.sendMoves(n.paths.map(path => ({ path, dx: n.dx, dy: n.dy })));
            },

            hitTestDropzone(clientX, clientY) {
                // Hit-test manual: independiente de pointer-events / stacking.
                const zones = document.querySelectorAll('.band-dropzone');
                for (const z of zones) {
                    const r = z.getBoundingClientRect();
                    if (r.width <= 0 || r.height <= 0) continue;
                    if (clientX >= r.left && clientX <= r.right &&
                        clientY >= r.top  && clientY <= r.bottom) {
                        return z;
                    }
                }
                return null;
            },

            updateDropzoneHover(evt) {
                document.querySelectorAll('.band-dropzone.hover').forEach(z => z.classList.remove('hover'));
                const dz = this.hitTestDropzone(evt.clientX, evt.clientY);
                if (dz) dz.classList.add('hover');
                return dz;
            },

            async finishCreate(evt) {
                const kind = this.creating.kind;
                const dz = this.hitTestDropzone(evt.clientX, evt.clientY);
                this.creating = null;
                document.querySelectorAll('.band-dropzone.hover').forEach(z => z.classList.remove('hover'));

                if (!dz) {
                    console.warn('[Designer] Drop fuera de dropzone — elemento no creado. Suelta sobre una banda.');
                    return;
                }

                const bandIndex = parseInt(dz.dataset.bandIndex, 10);
                const rect = dz.getBoundingClientRect();
                // rect y clientX/Y están en viewport-px; el zoom CSS escaló todo igual.
                // Dividir el offset por zoom convierte de vuelta a page-pt.
                const xInPage = (evt.clientX - rect.left) / this.zoom;
                const yInBand = (evt.clientY - rect.top)  / this.zoom;

                const root = document.querySelector('[data-preview-root]');
                const marginLeft = parseFloat(root?.dataset.marginLeft) || 0;
                // bounds.X en el YAML es relativo al content origin (sin margen izquierdo de página).
                let xYaml = Math.max(0, xInPage - marginLeft);
                let yYaml = Math.max(0, yInBand);
                if (evt.shiftKey) {
                    xYaml = Math.round(xYaml / this.SNAP) * this.SNAP;
                    yYaml = Math.round(yYaml / this.SNAP) * this.SNAP;
                }

                this.pushUndo();
                this.saving = true;
                try {
                    const form = this.buildFormData();
                    form.append('BandIndex', bandIndex.toString());
                    form.append('Kind', kind);
                    form.append('X', xYaml.toFixed(2));
                    form.append('Y', yYaml.toFixed(2));
                    const res = await fetch('/Home/Add', { method: 'POST', body: form });
                    const data = await res.json();
                    if (data.error) {
                        console.error('Add:', data.error);
                    } else {
                        this.applyServerResponse(data);
                        if (data.newPath) this.reselectByPath(data.newPath);
                    }
                } finally { this.saving = false; }
            },

            onOverlayPointerDown(evt) {
                // 1) Si clickearon un resize handle (solo en elemento ya seleccionado), iniciar resize.
                const handle = evt.target.closest('.resize-handle');
                if (handle) {
                    this.startResize(evt, handle);
                    return;
                }

                // 2) Clic en vacío: arranca una selección por marco (Shift = sumar a la actual).
                const target = evt.target.closest('.element-overlay');
                const additive = evt.shiftKey || evt.metaKey || evt.ctrlKey;
                if (!target) {
                    if (!evt.target.closest('.svg-page')) { if (!additive) this.clearSelection(); return; }
                    evt.preventDefault();
                    this.marquee = { x0: evt.clientX, y0: evt.clientY, x1: evt.clientX, y1: evt.clientY, active: false, additive };
                    return;
                }
                evt.preventDefault();

                // 3) Shift/Cmd/Ctrl + clic: agrega o quita de la selección (sin arrastrar).
                if (additive) {
                    this.toggleInSelection(target);
                    return;
                }

                // 4) Clic sobre un elemento ya seleccionado en una multi-selección: arrastrar todo el grupo.
                const inSelection = this.selection.some(s => s.path === target.dataset.path);
                if (!(inSelection && this.isMulti)) this.setSelection([target]);
                else this.setPrimary(target);

                const items = [];
                for (const s of this.selection) {
                    document.querySelectorAll(`.element-overlay[data-path="${s.path}"]`).forEach(el => items.push({
                        el, origLeft: parseFloat(el.style.left) || 0, origTop: parseFloat(el.style.top) || 0
                    }));
                }
                // Caja del grupo (coords de página, sobre la misma hoja que el elemento agarrado) para las guías.
                const pageEl = target.closest('.svg-page');
                const moving = new Set(this.selectionPaths());
                let box = null;
                for (const i of items) {
                    if (i.el.closest('.svg-page') !== pageEl) continue;
                    const d = i.el.dataset, x = +d.x, y = +d.y, r = x + +d.w, b = y + +d.h;
                    box = box ? { x: Math.min(box.x, x), y: Math.min(box.y, y), r: Math.max(box.r, r), b: Math.max(box.b, b) }
                              : { x, y, r, b };
                }
                this.dragging = {
                    paths: this.selectionPaths(),
                    startX: evt.clientX,
                    startY: evt.clientY,
                    dx: 0, dy: 0,
                    items,
                    el: target,
                    moved: false,
                    pageEl,
                    box: box ? { x: box.x, y: box.y, w: box.r - box.x, h: box.b - box.y } : null,
                    guides: pageEl ? this.collectGuideTargets(pageEl, moving) : null
                };
                target.setPointerCapture?.(evt.pointerId);
            },

            startResize(evt, handle) {
                evt.preventDefault();
                evt.stopPropagation();
                const el = handle.closest('.element-overlay');
                if (!el || !el.classList.contains('selected')) return;

                el.classList.add('resizing');
                this.resizing = {
                    dir: handle.dataset.dir,
                    el,
                    startX: evt.clientX,
                    startY: evt.clientY,
                    origX: parseFloat(el.dataset.x) || 0,
                    origY: parseFloat(el.dataset.y) || 0,
                    origW: parseFloat(el.dataset.w) || 0,
                    origH: parseFloat(el.dataset.h) || 0,
                    origLeft: parseFloat(el.style.left) || 0,
                    origTop:  parseFloat(el.style.top)  || 0,
                    origStyleW: parseFloat(el.style.width)  || 0,
                    origStyleH: parseFloat(el.style.height) || 0,
                    pendingBounds: null
                };
                el.setPointerCapture?.(evt.pointerId);
            },

            computeResize(r, dx, dy) {
                let nx = r.origX, ny = r.origY, nw = r.origW, nh = r.origH;
                if (r.dir.includes('w')) { nx = r.origX + dx; nw = r.origW - dx; }
                if (r.dir.includes('e')) { nw = r.origW + dx; }
                if (r.dir.includes('n')) { ny = r.origY + dy; nh = r.origH - dy; }
                if (r.dir.includes('s')) { nh = r.origH + dy; }

                // Clamp mínimo: si el ancho/alto cae bajo el mínimo, compensar en el origen
                // para que el lado opuesto quede anclado.
                if (nw < this.MIN_SIZE) {
                    const excess = this.MIN_SIZE - nw;
                    if (r.dir.includes('w')) nx -= excess;
                    nw = this.MIN_SIZE;
                }
                if (nh < this.MIN_SIZE) {
                    const excess = this.MIN_SIZE - nh;
                    if (r.dir.includes('n')) ny -= excess;
                    nh = this.MIN_SIZE;
                }
                return { x: nx, y: ny, w: nw, h: nh };
            },

            // Bounds del YAML (relativos a la banda). Si el overlay no los trae, cae al bbox renderizado.
            yamlBounds(ds) {
                const num = (v, fallback) => { const n = parseFloat(v); return Number.isFinite(n) ? n : fallback; };
                return {
                    x: num(ds.bx, parseFloat(ds.x) || 0),
                    y: num(ds.by, parseFloat(ds.y) || 0),
                    w: num(ds.bw, parseFloat(ds.w) || 0),
                    h: num(ds.bh, parseFloat(ds.h) || 0)
                };
            },

            syncFormFromDataset(ds) {
                const b = this.yamlBounds(ds);
                this.form.x      = +b.x.toFixed(2);
                this.form.y      = +b.y.toFixed(2);
                this.form.width  = +b.w.toFixed(2);
                this.form.height = +b.h.toFixed(2);
                this.form.style    = ds.style    || '';
                this.form.content  = ds.content  || '';
                this.form.color    = ds.color    || '#000000';
                this.form.thickness= parseFloat(ds.thickness) || 0.5;
                this.form.fill     = ds.fill     || '#ffffff';
                // table
                this.form.rows              = ds.rows              || '';
                this.form.headerMode        = ds.headerMode        || 'RepeatOnPageBreak';
                this.form.headerHeight      = parseFloat(ds.headerHeight) || 22;
                this.form.rowHeight         = parseFloat(ds.rowHeight)    || 18;
                this.form.headerStyle       = ds.headerStyle       || '';
                this.form.rowStyle          = ds.rowStyle          || '';
                this.form.alternateRowStyle = ds.alternateRowStyle || '';
                this.form.columnCount       = parseInt(ds.columnCount, 10) || 0;
                // v1.1
                this.form.visible           = ds.visible || '';
                this.form.cornerRadius      = parseFloat(ds.cornerRadius) || 0;
                this.form.source            = ds.source || '';
                this.form.fit               = ds.fit || 'contain';
                this.form.value             = ds.value || '';
                this.form.barcodeFormat     = (ds.barcodeFormat || 'qr').toLowerCase();
                this.form.barcodeForeground = ds.barcodeForeground || '#000000';
                this.form.barcodeBackground = ds.barcodeBackground || '#ffffff';
                this.form.chartType         = ds.chartType || 'bar';
                this.form.category          = ds.category || '';
                this.form.title             = ds.title || '';
                this.form.legend            = ds.legend || '';
                this.form.showValues        = ds.showValues === 'true';
                this.form.showPercent       = ds.showPercent === 'true';
                this.form.stacked           = ds.stacked === 'true';
                this.form.valueFormat       = ds.valueFormat || '';
                try {
                    const palette = ['#2563EB', '#F59E0B', '#10B981', '#EF4444', '#8B5CF6', '#06B6D4'];
                    this.form.series = JSON.parse(ds.series || '[]').map((se, i) => ({
                        name: se.name ?? se.Name ?? '',
                        value: se.value ?? se.Value ?? '',
                        color: (se.color ?? se.Color) || palette[i % palette.length]
                    }));
                } catch { this.form.series = []; }
                if (this.form.rows) this.refreshRowPaths(this.form.rows);
                try {
                    const parsed = JSON.parse(ds.columns || '[]');
                    // Normaliza PascalCase ↔ camelCase (servidor emite PascalCase por JsonSerializer default).
                    this.form.columns = parsed.map(c => ({
                        header: c.header ?? c.Header ?? '',
                        binding: c.binding ?? c.Binding ?? '',
                        width: c.width ?? c.Width ?? 0,
                        format: c.format ?? c.Format ?? '',
                        align: c.align ?? c.Align ?? 'left',
                        expanded: false
                    }));
                } catch { this.form.columns = []; }
            },

            onPointerMove(evt) {
                if (this.resizingEditor) {
                    this.editorWidth = Math.round(Math.min(this.maxEditorWidth(),
                        Math.max(this.EDITOR_MIN, evt.clientX - this.resizingEditor.left)));
                    return;
                }
                if (this.marquee) {
                    this.marquee.x1 = evt.clientX;
                    this.marquee.y1 = evt.clientY;
                    if (!this.marquee.active &&
                        (Math.abs(this.marquee.x1 - this.marquee.x0) > 4 || Math.abs(this.marquee.y1 - this.marquee.y0) > 4))
                        this.marquee.active = true;
                    return;
                }
                if (this.creating) {
                    this.creating.x = evt.clientX;
                    this.creating.y = evt.clientY;
                    this.updateDropzoneHover(evt);
                    return;
                }

                if (this.resizing) {
                    const r = this.resizing;
                    // Convertir delta de viewport-px a page-pt dividiendo por el zoom actual.
                    let dx = (evt.clientX - r.startX) / this.zoom;
                    let dy = (evt.clientY - r.startY) / this.zoom;
                    if (evt.shiftKey) {
                        dx = Math.round(dx / this.SNAP) * this.SNAP;
                        dy = Math.round(dy / this.SNAP) * this.SNAP;
                    }
                    const nb = this.computeResize(r, dx, dy);
                    r.el.style.left   = (r.origLeft + (nb.x - r.origX)) + 'px';
                    r.el.style.top    = (r.origTop  + (nb.y - r.origY)) + 'px';
                    r.el.style.width  = Math.max(nb.w, this.MIN_SIZE) + 'px';
                    r.el.style.height = Math.max(nb.h, this.MIN_SIZE) + 'px';
                    r.pendingBounds = nb;
                    return;
                }

                if (!this.dragging) return;
                // Convertir delta de viewport-px a page-pt dividiendo por el zoom actual.
                let dx = (evt.clientX - this.dragging.startX) / this.zoom;
                let dy = (evt.clientY - this.dragging.startY) / this.zoom;
                if (evt.shiftKey) {
                    dx = Math.round(dx / this.SNAP) * this.SNAP;
                    dy = Math.round(dy / this.SNAP) * this.SNAP;
                    this.renderGuides(null);
                } else if (this.smartGuides && !evt.altKey && this.dragging.box && this.dragging.guides) {
                    [dx, dy] = this.snapToGuides(this.dragging, dx, dy);
                } else {
                    this.renderGuides(null);
                }
                this.dragging.dx = dx; this.dragging.dy = dy;
                if (!this.dragging.moved && (Math.abs(dx) > 2 || Math.abs(dy) > 2)) {
                    this.dragging.moved = true;
                    this.dragging.items.forEach(i => i.el.classList.add('dragging'));
                }
                if (this.dragging.moved) {
                    for (const i of this.dragging.items) {
                        i.el.style.left = (i.origLeft + dx) + 'px';
                        i.el.style.top  = (i.origTop  + dy) + 'px';
                    }
                }
            },

            async onPointerUp(evt) {
                if (this.resizingEditor) {
                    this.resizingEditor = null;
                    document.body.style.cursor = '';
                    document.body.style.userSelect = '';
                    window.getSelection()?.removeAllRanges();
                    this.persistEditorLayout();
                    this.onLayoutChanged();
                    return;
                }
                if (this.marquee) {
                    const m = this.marquee;
                    this.marquee = null;
                    if (!m.active) { if (!m.additive) this.clearSelection(); return; }
                    const left = Math.min(m.x0, m.x1), right = Math.max(m.x0, m.x1);
                    const top = Math.min(m.y0, m.y1), bottom = Math.max(m.y0, m.y1);
                    const hits = [];
                    const seen = new Set(m.additive ? this.selectionPaths() : []);
                    for (const el of document.querySelectorAll('.element-overlay')) {
                        const r = el.getBoundingClientRect();
                        const intersects = r.right >= left && r.left <= right && r.bottom >= top && r.top <= bottom;
                        if (intersects && !seen.has(el.dataset.path)) { seen.add(el.dataset.path); hits.push(el); }
                    }
                    const base = m.additive ? this.selection.map(s => this.overlayFor(s.path)).filter(Boolean) : [];
                    this.setSelection([...base, ...hits]);
                    return;
                }
                if (this.creating) {
                    await this.finishCreate(evt);
                    return;
                }

                if (this.resizing) {
                    const r = this.resizing;
                    this.resizing = null;
                    r.el.classList.remove('resizing');
                    if (!r.pendingBounds) return;

                    const nb = r.pendingBounds;
                    // Skip si no hubo cambio real
                    if (Math.abs(nb.x - r.origX) < 0.5 && Math.abs(nb.y - r.origY) < 0.5 &&
                        Math.abs(nb.w - r.origW) < 0.5 && Math.abs(nb.h - r.origH) < 0.5) return;
                    // El resize se calcula sobre el bbox renderizado (coordenadas de página); al YAML se
                    // envían los mismos deltas aplicados a sus bounds relativos a la banda.
                    const yb = this.yamlBounds(r.el.dataset);
                    const x = +(yb.x + (nb.x - r.origX)).toFixed(2);
                    const y = +(yb.y + (nb.y - r.origY)).toFixed(2);
                    const w = +Math.max(this.MIN_SIZE, yb.w + (nb.w - r.origW)).toFixed(2);
                    const h = +Math.max(0, yb.h + (nb.h - r.origH)).toFixed(2);

                    this.pushUndo();
                    this.saving = true;
                    const savedPath = r.el.dataset.path;
                    try {
                        const form = this.buildFormData();
                        form.append('Path', savedPath);
                        form.append('X', x.toString());
                        form.append('Y', y.toString());
                        form.append('Width', w.toString());
                        form.append('Height', h.toString());
                        const res = await fetch('/Home/Update', { method: 'POST', body: form });
                        const data = await res.json();
                        if (data.error) {
                            // Restaurar visualmente
                            r.el.style.left = r.origLeft + 'px';
                            r.el.style.top  = r.origTop  + 'px';
                            r.el.style.width  = r.origStyleW + 'px';
                            r.el.style.height = r.origStyleH + 'px';
                            console.error('Resize:', data.error);
                        } else {
                            this.applyServerResponse(data);
                            this.reselectByPath(savedPath);
                        }
                    } finally { this.saving = false; }
                    return;
                }

                const drag = this.dragging;
                if (!drag) return;
                this.dragging = null;
                this.renderGuides(null);
                if (!drag.moved) return;
                drag.items.forEach(i => i.el.classList.remove('dragging'));

                const ok = await this.sendMoves(drag.paths.map(path => ({ path, dx: +drag.dx.toFixed(2), dy: +drag.dy.toFixed(2) })));
                if (!ok) {
                    for (const i of drag.items) {
                        i.el.style.left = i.origLeft + 'px';
                        i.el.style.top  = i.origTop  + 'px';
                    }
                }
            },

            async applyPatch(patch) {
                if (!this.selected) return;
                this.pushUndo();
                this.saving = true;
                try {
                    const form = this.buildFormData();
                    form.append('Path', this.selected.path);
                    for (const [k, v] of Object.entries(patch)) {
                        if (v === null || v === undefined || v === '') continue;
                        form.append(k, String(v));
                    }
                    const res = await fetch('/Home/Update', { method: 'POST', body: form });
                    const data = await res.json();
                    if (data.error) {
                        console.error('Update:', data.error);
                    } else {
                        const preservedPath = this.selected.path;
                        this.applyServerResponse(data);
                        this.reselectByPath(preservedPath);
                    }
                } finally { this.saving = false; }
            },

            buildFormData() {
                const form = new FormData();
                form.append('Yaml', this.getEditorText('yaml'));
                form.append('Json', this.getEditorText('json'));
                return form;
            },

            applyServerResponse(data) {
                this.setEditorText('yaml', data.yaml);
                this.setPreviewHtml(data.previewHtml);
                this.selected = null;
                this.selection = [];
                this.isDirty = true;
                this.refreshBandsFromPreview();
                // El partial llega con --zoom: 1; sin esto el preview vuelve a 100% tras cada edición.
                this.applyZoomToDom();
            },

            /** Todo HTML de preview que no llega por HTMX pasa por aquí. */
            setPreviewHtml(html) {
                document.getElementById('preview').innerHTML = html;
                this.refreshBandsFromPreview();
                this.applyZoomToDom();
                this.syncPreviewDecorations();
            },

            overlayFor(path) {
                return document.querySelector(`.element-overlay[data-path="${path}"]`);
            },

            // Pinta las clases: con un solo elemento → 'selected' (handles de resize);
            // con varios → 'multi-selected' en todos (sin handles). Cubre overlays repetidos por página.
            renderSelectionClasses() {
                document.querySelectorAll('.element-overlay.selected, .element-overlay.multi-selected')
                    .forEach(e => e.classList.remove('selected', 'multi-selected'));
                const cls = this.selection.length > 1 ? 'multi-selected' : 'selected';
                for (const s of this.selection)
                    document.querySelectorAll(`.element-overlay[data-path="${s.path}"]`).forEach(e => e.classList.add(cls));
                this.revealInEditor(this.selected?.path ?? null);
                this.drawRulers();
            },

            setSelection(elements, primaryEl = null) {
                const unique = [];
                const seen = new Set();
                for (const el of elements) {
                    if (!el || seen.has(el.dataset.path)) continue;
                    seen.add(el.dataset.path);
                    unique.push(el);
                }
                this.selection = unique.map(el => ({ path: el.dataset.path, kind: el.dataset.kind }));
                const primary = primaryEl ?? unique[unique.length - 1] ?? null;
                this.selected = primary ? { path: primary.dataset.path, kind: primary.dataset.kind, el: primary } : null;
                if (primary) this.syncFormFromDataset(primary.dataset);
                this.renderSelectionClasses();
            },

            setPrimary(el) {
                this.selected = { path: el.dataset.path, kind: el.dataset.kind, el };
                this.syncFormFromDataset(el.dataset);
            },

            toggleInSelection(el) {
                const path = el.dataset.path;
                const current = this.selection.map(s => this.overlayFor(s.path)).filter(Boolean);
                const next = this.selection.some(s => s.path === path)
                    ? current.filter(e => e.dataset.path !== path)
                    : [...current, el];
                this.setSelection(next);
            },

            reselectByPath(path, preserveFormState = false) {
                const el = this.overlayFor(path);
                if (!el) return;
                this.selection = [{ path: el.dataset.path, kind: el.dataset.kind }];
                this.selected = { path: el.dataset.path, kind: el.dataset.kind, el };
                if (!preserveFormState) {
                    this.syncFormFromDataset(el.dataset);
                }
                this.renderSelectionClasses();
            },

            reselectByPaths(paths, primaryPath = null) {
                const els = paths.map(p => this.overlayFor(p)).filter(Boolean);
                const primary = primaryPath ? this.overlayFor(primaryPath) : null;
                this.setSelection(els, primary);
            },

            clearSelection() {
                document.querySelectorAll('.element-overlay.selected, .element-overlay.multi-selected')
                    .forEach(e => e.classList.remove('selected', 'multi-selected'));
                this.selected = null;
                this.selection = [];
                this.revealInEditor(null);
            },

            // === Template persistence ===

            async refreshTemplates() {
                try {
                    const res = await fetch('/Home/ListTemplates');
                    const data = await res.json();
                    this.availableTemplates = Array.isArray(data) ? data : [];
                } catch (err) {
                    console.error('List templates:', err);
                    this.availableTemplates = [];
                }
            },

            async onSelectionChange() {
                if (!this.currentSelection) return;
                if (this.isDirty && !confirm('Hay cambios sin guardar. ¿Descartarlos y cargar el template?')) {
                    this.currentSelection = '';
                    return;
                }

                const isSample = this.currentSelection.startsWith('sample:');
                const name = isSample ? this.currentSampleName : this.currentTemplate;
                const url = isSample
                    ? '/Home/LoadSample?name=' + encodeURIComponent(name)
                    : '/Home/LoadTemplate?name=' + encodeURIComponent(name);

                try {
                    const res = await fetch(url);
                    const data = await res.json();
                    if (data.error) { alert('Error al cargar: ' + data.error); return; }
                    await this.applyLoadedContent(data.yaml || '', data.json || '{}');
                } catch (err) { alert('Error al cargar: ' + err); }
            },

            async applyLoadedContent(yaml, json) {
                this.setEditorText('yaml', yaml);
                this.setEditorText('json', json);
                this.refreshJsonPaths();
                this.isDirty = false;
                this.undoStack = [];
                this.redoStack = [];
                this.clearSelection();
                await this.restoreSnapshot(yaml);
            },

            // === Importar archivo desde disco ===

            importFile() {
                document.getElementById('import-input').click();
            },

            async onImportFiles(evt) {
                const files = Array.from(evt.target.files || []);
                if (files.length === 0) return;
                if (this.isDirty && !confirm('Hay cambios sin guardar. ¿Descartarlos al importar?')) {
                    evt.target.value = '';
                    return;
                }

                let yamlText = null, jsonText = null;
                for (const f of files) {
                    const lower = f.name.toLowerCase();
                    const text = await f.text();
                    if (lower.endsWith('.yaml') || lower.endsWith('.yml')) yamlText = text;
                    else if (lower.endsWith('.json')) jsonText = text;
                }

                evt.target.value = '';   // permitir re-seleccionar el mismo archivo en el futuro

                if (yamlText === null && jsonText === null) {
                    alert('Selecciona al menos un .yaml o .json válido.');
                    return;
                }

                // Si solo uno fue importado, mantener el otro tal cual está.
                const currentYaml = this.getEditorText('yaml');
                const currentJson = this.getEditorText('json');
                this.currentSelection = '';   // template importado deja de ser sample/user
                await this.applyLoadedContent(yamlText ?? currentYaml, jsonText ?? currentJson);
            },

            async saveTemplate() {
                if (!this.currentTemplate) { await this.saveAsTemplate(); return; }
                await this.saveToName(this.currentTemplate);
            },

            async saveAsTemplate() {
                const name = prompt('Nombre del template (letras, dígitos, espacios, - o _):',
                                    this.currentTemplate || this.currentSampleName || '');
                if (!name) return;
                if (await this.saveToName(name)) {
                    this.currentSelection = 'user:' + name.trim();
                    await this.refreshTemplates();
                }
            },

            async saveToName(name) {
                const form = new FormData();
                form.append('Name', name);
                form.append('Yaml', this.getEditorText('yaml'));
                form.append('Json', this.getEditorText('json'));
                try {
                    const res = await fetch('/Home/SaveTemplate', { method: 'POST', body: form });
                    const data = await res.json();
                    if (data.error) { alert('Error al guardar: ' + data.error); return false; }
                    this.isDirty = false;
                    return true;
                } catch (err) { alert('Error al guardar: ' + err); return false; }
            },

            async deleteTemplate() {
                if (!this.isUserTemplate) return;
                const name = this.currentTemplate;
                if (!confirm(`¿Borrar template "${name}"? Esta acción no se puede deshacer.`)) return;

                const form = new FormData();
                form.append('Name', name);
                try {
                    const res = await fetch('/Home/DeleteTemplate', { method: 'POST', body: form });
                    const data = await res.json();
                    if (data.error) { alert('Error al borrar: ' + data.error); return; }
                    this.currentSelection = '';
                    await this.refreshTemplates();
                } catch (err) { alert('Error al borrar: ' + err); }
            }
        };
    }
</script>
